@model HemenTanitim.Models.Footer
@using Resources;
@{
    ViewBag.Title = "Edit düzenleme";
    Layout = "~/Views/Shared/Admin.cshtml";
}


<aside class="right-side">
    <section class="content-header">
        <h1>
            Footer d&#252;zenle

        </h1>
        <ol class="breadcrumb">
            <li><a href="@Url.Action("Dasboard")"><i class="fa fa-dashboard"></i> Anasayfa</a></li>
            <li><a href="@Url.Action("Index")">Footer  i&#351;lemleri</a></li>
            <li class="active">Footer  d&#252;zenle</li>
        </ol>
    </section>

    <section class="content">
