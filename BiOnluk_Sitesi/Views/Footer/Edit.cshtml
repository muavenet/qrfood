                                    @Html.TextBoxFor(model => model.Kategori3, new { @class = "form-control", data_toggle = "tooltip", data_placement = "top", title = "Tooltip on top" })
                                    @Html.ValidationMessageFor(model => model.Kategori3)
                                </div>
                               <label class="control-label col-lg-2">@Html.LabelFor(model => model.Kategori3Link)</label>
                               <div class="col-lg-5">                                   @Html.TextBoxFor(model => model.Kategori3Link, new { @class = "form-control", data_toggle = "tooltip", data_placement = "top", placeholder = "Kategori linki" })
                                   @Html.ValidationMessageFor(model => model.Kategori3Link)
