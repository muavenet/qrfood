                        {

                            @Html.ValidationSummary(true)

                            @Html.HiddenFor(model => model.Id)
                            
                           <div class="form-group">
                                <label class="control-label col-lg-2">@Html.LabelFor(model => model.Kategori1)</label>
                                <div class="col-lg-2">
                                    @Html.TextBoxFor(model => model.Kategori1, new { @class = "form-control", data_toggle = "tooltip", data_placement = "top", title = "Tooltip on top" })
                                    @Html.ValidationMessageFor(model => model.Kategori1)
                                </div>
                               <label class="control-label col-lg-2">@Html.LabelFor(model => model.Kategori1Link)</label>
                               <div class="col-lg-5">                                   @Html.TextBoxFor(model => model.Kategori1Link, new { @class = "form-control", data_toggle = "tooltip", data_placement = "top", placeholder = "Kategori linki" })
                                   @Html.ValidationMessageFor(model => model.Kategori1Link)
                               </div>
                            </div>
                            
                              <div class="form-group">
                                <label class="control-label col-lg-2">@Html.LabelFor(model => model.Kategori2)</label>
