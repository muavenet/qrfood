                    </div>
                </div>
            </div>
        </div>
        <div>
            <a href="@Url.Action("Index")">Listeye d&#246;n</a>
        </div>
    </section>
</aside>

@section scriptFooter{
    @Scripts.Render("~/bundles/bootstrap-wysihtml5")
    <script>

        $(document).ready(function () {

            $("li").removeClass("active");
            $("#ayarlar").addClass("active");
            $("#ayarlar_menu").css("display", "block");
            $("#ayarlar_footer").addClass("active");
            $("#ayarlar_arrow").addClass("fa-angle-down");

            $("#wysihtml5").wysihtml5();

        });
    </script>
}

