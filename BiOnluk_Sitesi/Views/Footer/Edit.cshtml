                                    @Html.ValidationMessageFor(model => model.Kategori5)
                                </div>
                               <label class="control-label col-lg-2">@Html.LabelFor(model => model.Kategori5Link)</label>
                               <div class="col-lg-5">                                   @Html.TextBoxFor(model => model.Kategori5Link, new { @class = "form-control", data_toggle = "tooltip", data_placement = "top", placeholder = "Kategori linki" })
                                   @Html.ValidationMessageFor(model => model.Kategori5Link)
                               </div>
                            </div>
                            
                               <div class="form-group">
                                <label class="control-label col-lg-2">@Html.LabelFor(model => model.Tags)</label>
                                <div class="col-lg-9">
                                    @Html.TextAreaFor(model => model.Tags, new { @class = "form-control", data_toggle = "tooltip", data_placement = "top", title = "Tooltip on top" })
                                    @Html.ValidationMessageFor(model => model.Tags)
                                </div>
                             
                            </div>
                            
    

                            <div class="form-actions no-margin-bottom" style="text-align:center;">
                                <input type="submit" value="Kaydet" class="btn btn-primary btn-lg " />
