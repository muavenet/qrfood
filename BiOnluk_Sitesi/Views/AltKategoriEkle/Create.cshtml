@model HemenTanitim.Models.AltKategoriEkle

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/Admin.cshtml";
}
<aside class="right-side">
    <section class="content-header">
        <h1>
            Alt kategori ekle
        </h1>
        <ol class="breadcrumb">
            <li><a href="@Url.Action("Dasboard")"><i class="fa fa-dashboard"></i> Anasayfa</a></li>
            <li class="active"> Ana kategori ekle</li>
        </ol>
    </section>
    <section class="content">
        <div class='row'>
            <div class='col-md-12'>
                <div class='box box-purple'>

                    <div class="box-body">

                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()

                                @Html.ValidationSummary(true)
                            
                              <div class="form-group">
                                    @Html.LabelFor(model => model.title)
                                    </div>
                                <div class="form-group">
                                        @Html.TextBoxFor(model => model.title, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.title)
                                 </div>
                            
                              <div class="form-group">
                                    @Html.LabelFor(model => model.metaDescripton)
                                    </div>
                                <div class="form-group">
                                        @Html.TextBoxFor(model => model.metaDescripton, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.metaDescripton)
                                 </div>
                            
                              <div class="form-group">
                                    @Html.LabelFor(model => model.metaKeywords)
                                    </div>
                                <div class="form-group">
                                        @Html.TextBoxFor(model => model.metaKeywords, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.metaKeywords)
                                 </div>
                            

                                <div class="form-group">
                                    @Html.LabelFor(model => model.KategoriAdi)
                                    </div>
                                <div class="form-group">
                                        @Html.TextBoxFor(model => model.KategoriAdi, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.KategoriAdi)
                                 </div>
                               

                                <div class="form-group">
                                    @Html.Label("Üst Kategori Adı")
                                   </div>
                                <div class="form-group">
                                    @Html.DropDownList("AnaKategoriId", "Seçiniz")
                                    @Html.ValidationMessageFor(model => model.AnaKategoriId)
                                </div>
                            
                           <div class="form-group">
                              @Html.LabelFor(model => model.Aciklama)

                                @Html.TextAreaFor(model => model.Aciklama, new { @class = "textarea", @style = "width: 100%; height: 200px; font-size: 14px; line-height: 18px; border: 1px solid #dddddd; padding: 10px;" })
                                @Html.ValidationMessageFor(model => model.Aciklama)
                            </div>
                            
                             <div class="form-group">
                                    @Html.LabelFor(model => model.tags)
                                    </div>
                                <div class="form-group">
                                        @Html.TextBoxFor(model => model.tags, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.tags)
                                 </div>

                                <div class="form-group">
                                    <div class="col-md-offset-2 col-md-10">
                                        <input type="submit" value="Kaydet" class="btn btn-primary" />
                                    </div>
                                </div>
                            
                        }

                        <div>
                            @Html.ActionLink("Geri dön", "Index")
                        </div>

                    </div>
                </div>
            </div>
            </div>
    </section>
</aside>
@section scriptFooter {
  

@Scripts.Render("~/bundles/bootstrap-wysihtml5")
<script>
    $(document).ready(function () {
        $("li").removeClass("active");
        $("#kategoriler").addClass("active");
        $("#kategoriler_menu").css("display", "block");
        $("#kategoriler_altKategori").addClass("active");
        $("#kategoriler_arrow").addClass("fa-angle-down");
        $(".textarea").wysihtml5();


    });
</script>
}