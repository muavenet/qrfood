@model HemenTanitim.Models.GenelBilgiler
@using Resources;
@{
    ViewBag.Title = "Edit düzenleme";
    Layout = "~/Views/Shared/Admin.cshtml";
}


<aside class="right-side">
    <section class="content-header">
        <h1>
            GenelBilgiler d&#252;zenle

        </h1>
        <ol class="breadcrumb">
            <li><a href="@Url.Action("Dasboard")"><i class="fa fa-dashboard"></i> Anasayfa</a></li>
            <li><a href="@Url.Action("Index")">GenelBilgiler  i&#351;lemleri</a></li>
            <li class="active">GenelBilgiler  d&#252;zenle</li>
        </ol>
    </section>

    <section class="content">
        <div class='row'>
            <div class='col-md-12'>
                <div class='box box-purple'>

                    <div class="box-body">

                       

                        @using (Html.BeginForm("Edit", "GenelBilgilers", FormMethod.Post, new { @class = "form-horizontal", @id = "block-validate", enctype = "multipart/form-data" }))
                        {

                            @Html.ValidationSummary(true)
                            @Html.HiddenFor(model => model.logo)


                            @Html.HiddenFor(model => model.Id)
                            @Html.Partial("_CreateOrEdit", Model)

                            <div class="form-actions no-margin-bottom" style="text-align:center;">
                                <input type="submit" value="Kaydet" class="btn btn-primary btn-lg " />
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div>
            <a href="@Url.Action("Index")">Listeye d&#246;n</a>
        </div>
    </section>
</aside>

@section scriptFooter{
    @Scripts.Render("~/bundles/bootstrap-wysihtml5")
    <script>

        $(document).ready(function () {

            $("li").removeClass("active");
            $("#ayarlar").addClass("active");
            $("#ayarlar_menu").css("display", "block");
            $("#ayarlar_genel").addClass("active");
            $("#ayarlar_arrow").addClass("fa-angle-down");

            $("#wysihtml5").wysihtml5();

        });
    </script>
}

