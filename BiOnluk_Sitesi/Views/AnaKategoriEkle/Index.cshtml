@model IEnumerable<HemenTanitim.Models.AnaKategoriler>

@{
    ViewBag.Title = "Ana kategoriler";
    Layout = "~/Views/Shared/Admin.cshtml";
}

<aside class="right-side">

    <section class="content-header">
        <h1>
            Ana Kategori Listesi
        </h1>
        <ol class="breadcrumb">
            <li><a href="#"><i class="fa fa-dashboard"></i> Anasayfa</a></li>
            <li><a href="#">Ana kategoriler</a></li>
    </section>

    <section class="content">
        <div class='row'>
            <div class='col-xs-12'>
                <div class='box box-info'>


                    <div class="box-body table-responsive" style="overflow:hidden">
                        <table id="tblListe" class="table table-bordered table-striped">

                            <div class='box-header'>
                                <h3 class='box-title'>@Html.ActionLink("Yeni ekle", "Create")</h3>
                            </div>

                            <table class="table">
                                <tr>
                                    <th>
                                        @Html.DisplayNameFor(model => model.KategoriAdi)
                                    </th>
                                    <th></th>
                                </tr>

                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.KategoriAdi)
                                        </td>
                                        <td>
                                            @Html.ActionLink("Düzenle", "Edit", new { id = item.Id }) |
                                            @Html.ActionLink("Sil", "Delete", new { id = item.Id })
                                        </td>
                                    </tr>
                                }

                            </table>
                            </div></div></div></div></section></aside>
<script>

    $(document).ready(function () {
      
        $("#kategoriler_anakategori ").addClass("active");
    });


</script>