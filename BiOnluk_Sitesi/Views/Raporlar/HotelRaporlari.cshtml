@model List<HemenTanitim.Models.Hotels>

@{
    ViewBag.Title = "Siparişler";
    Layout = "~/Views/Shared/Admin.cshtml";
}



<style>
    .body-content .my-wishlist-page .my-wishlist table > thead > tr > th, .table > tbody > tr > th, .table > tfoot > tr > th,
    .table > thead > tr > td, .table > tbody > tr > td, .table > tfoot > tr > td {
        padding: 12px !important;
    }
</style>




<style>
    .text-center {
        text-align: left;
    }
</style>


<aside class="right-side">

    <section class="content-header"> 
        <ol class="breadcrumb">
            <li><a href="@Url.Action("Index","AdminDasboard")"><i class="fa fa-dashboard"></i> Anasayfa</a></li>
            <li class="active">Hotel listesi</li>
        </ol>
    </section>

    <section class="content">
        <div class='row'>
            <div class='col-xs-12'>
                <div class='box box-info'>

                    <div class="box-body table-responsive" style="overflow:hidden">
                        <table id="tblListe" class="table table-bordered table-striped">

                            <thead>
                                <tr>

                                    <th>
                                       Hotel Adı
                                    </th>
                                    <th>
                                        Oda Sayısı
                                    </th>

                                    <th>
                                        Komisyon
                                    </th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>

                                @{string sonuc = ""; }
                                @foreach (var item in Model)
                                {

                                    <tr>
                                        <td>
                                            @item.HotelAdi
                                        </td>

                                        <td>
                                            <b>@item.odaSayisi</b>
                                        </td>


                                        <td>
                                            @item.KomisyonOrani
                                        </td>
                                        <td>
                                            <a class="btn btn-success" href="@Url.Action("HotelRaporlariDetay", "Raporlar", new { id= item.Id})">Detaylar</a>
                                        </td>
                                    </tr>
                                }
                            <tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>
</aside>


@section scriptFooter{

    @Scripts.Render("~/bundles/datatables")

    <script src="~/Scripts/plugins/datatables/dataTablesConfigurations.js"></script>

    <script type="text/javascript">

        function ddlTes(e) {

            var val = $(e).val();

            $.ajax({
                url: "/AdminSiparisIslemleri/TeslimDurumuDegistir",
                data: { selectedValue: val, Id: e.id },
                type: "POST",
                dataType: "json",
                success: function (result) { },
                error: function (error) { alert(error); }
            })

        }

        $(document).ready(function () {
            $("#HotelRaporlari").addClass("active");
        });



    </script>



}


