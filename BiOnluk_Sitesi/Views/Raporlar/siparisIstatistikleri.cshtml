@model IEnumerable<HemenTanitim.Models.SiparisIstatistikleri>


@{
    ViewBag.Title = "siparisIstatistikleri";
    Layout = "~/Views/Shared/Admin.cshtml";
}

<style>
    .text-center {
        text-align: left;
    }
</style>



<aside class="right-side">

    <section class="content-header">
        <h1>Sipariş İstatistikleri</h1>
        <ol class="breadcrumb">
            <li><a href="@Url.Action("Index","AdminDasboard")"><i class="fa fa-dashboard"></i> Anasayfa</a></li>
            <li class="active">Sipariş İstatistikleri</li>
        </ol>
    </section>

    <section class="content">
        <div class='row'>
            <div class='col-xs-12'>
                <div class='box box-info'>
                    <div class="box-header">
                        <div class="box-title">
                            <a href="@Url.Action("ExceleAktar", new { paramaterName = "siparisIstatistikleri" })" class="btn btn-default btn-flat">
                                <i class="fa fa-download"></i>&nbsp;
                                Excel'e aktar
                            </a>
                        </div>
                    </div>
                    <div class="box-body table-responsive" style="overflow:hidden">

                        <div class="box-body chart-responsive">
                            <div class="chart" id="bar-chart" style="height:200px"></div>
                        </div><!-- /.box-body -->

                        <table id="tblListe" class="table table-bordered table-striped">


                            <thead>
                                <tr>

                                    <th>
                                        @Html.DisplayNameFor(model => model.TeslimDurumu)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Sayi)
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>

                                        <td>
                                            @item.TeslimDurumu
                                        </td>
                                        <td>
                                            @item.Sayi
                                        </td>

                                    </tr>
                                }
                            <tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>
</aside>



@section scriptFooter{

    @Scripts.Render("~/bundles/datatables")

    <script src="~/Scripts/plugins/datatables/dataTablesConfigurations.js"></script>

@Scripts.Render("~/bundles/raphael")
@Scripts.Render("~/bundles/morris")


    <script>

        $(function () {

            var result = [];

            $.ajax({

                url: "@Url.Action("siparisIstatistikleriGrafikTablosu")",

                type: "GET",

            data: {},

            success: function (data) {

                $.each(data, function (id, book) {
                    result.push({ "y": book.TeslimDurumu, "x": book.Sayi });
                });
               
                var area = new Morris.Bar({
                    element: 'bar-chart',
                    resize: true,
                    data:  result,
                    barColors: ['#a0d0e0', '#3c8dbc'],
                    xkey: 'y',
                    ykeys: ['x'],
                    labels: ['Adet', 'DISK'],
                    hideHover: 'auto'
                });

            }
        });
        });


        $(document).ready(function () {



            $("li").removeClass("active");
            $("#raporlar").addClass("active");
            $("#raporlar_menu").css("display", "block");
            $("#siparisIstatistikleri").addClass("active");
            $("#raporlar_arrow").addClass("fa-angle-down");
        });

    </script>

}

