
@model HemenTanitim.Models.UstMenuModel


<div class="col-lg-6 col-xs-6">
    <!-- small box -->
    <div class="small-box bg-aqua">
        <div class="inner">
            <h3>
                @Model.YeniSiparis
            </h3>
            <p>
                Yeni sipariş (@DateTime.Now.ToShortDateString())
            </p>
        </div>
        <div class="icon">
            <i class="ion ion-bag"></i>
        </div>
        <a href="#" class="small-box-footer">
            @*<a href="@Url.Action("Index","AdminSiparisIslemleri")" class="small-box-footer">*@
            Bugüne ait siparişlerdir 
        </a>
    </div>
</div><!-- ./col -->

<div class="col-lg-6 col-xs-6">
    <!-- small box -->
    <div class="small-box bg-green">
        <div class="inner">
            <h3>
                @Model.toplamSiparis
            </h3>
            <p>
                Gelen toplam sipariş
            </p>
        </div>
        <div class="icon">
            <i class="ion ion-stats-bars"></i>
        </div>
        <a href="#" class="small-box-footer">
            <a href="@Url.Action("Siparisler","AdminDasboard")" class="small-box-footer">
                Tüm siparişlere git<i class="fa fa-arrow-circle-right"></i>
            </a>
</div>
</div><!-- ./col -->
