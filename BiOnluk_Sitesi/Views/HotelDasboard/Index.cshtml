

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/AdminHotel.cshtml";
}

<!-- Right side column. Contains the navbar and content of the page -->
<aside class="right-side">
    <!-- Content Header (Page header) -->
    <section class="content-header">

        <h1>
            <i class="fa fa-dashboard"></i> Gösterge Paneli <small>Anasayfa</small>
        </h1>

    </section>
    <!-- Main content -->
    <section class="content">
        <!-- Small boxes (Stat box) -->
        <div class="row">
            @{Html.RenderAction("_UstMenu", "HotelDasboard");}
        </div><!-- /.row -->
        <!-- Main row -->
        <!-- Left col -->
        <section class="connectedSortable">

            <div class="item_dasboard col-lg-12">
                @{Html.RenderAction("_GunlukSatisGrafigi", "HotelDasboard");}
            </div>

            <div class="item_dasboard col-lg-12">
                @{Html.RenderAction("_AylikSatisGrafigi", "HotelDasboard");}
            </div>

            @*<div class="item_dasboard col-lg-12">
                    @{Html.RenderAction("_QuickEmail", "AdminDasboard");}
                </div>*@



        </section>
    </section><!-- /.content -->
</aside><!-- /.right-side -->
<script src="~/Scripts/jquery-2.2.1.min.js"></script>
@Scripts.Render("~/bundles/AdminLTE_Dashboard")
@Scripts.Render("~/bundles/raphael")
@Scripts.Render("~/bundles/morris")
@Scripts.Render("~/bundles/sparkline")
@Scripts.Render("~/bundles/jvectormap")
@Scripts.Render("~/bundles/jqueryKnob")
@Scripts.Render("~/bundles/daterangepicker")
@Scripts.Render("~/bundles/datepicker")
@Scripts.Render("~/bundles/iCheck")
<script src="~/Scripts/plugins/ckeditor/ckeditor.js"></script>

<script type="text/javascript">
    $(document).ready(function () {

        CKEDITOR.replace('mailIcerik',
        {

            height: '200px'
        });


        $conf(document).ready(function () {
            $conf(".left-side").addClass("collapse-left");
        });
    });
</script>

