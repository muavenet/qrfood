@model IEnumerable<HemenTanitim.Models.Mesajlar>

@using Resources;

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/Admin.cshtml";

}

<style>
    .text-center {
        text-align: left;
    }
</style>

<aside class="right-side">

    <section class="content-header">
        <h1>
            Mesajlar listesi - @ViewBag.SiparisTuru
        </h1>
        <ol class="breadcrumb">
            <li><a href="@Url.Action("Index","AdminDasboard")"><i class="fa fa-dashboard"></i> Anasayfa</a></li>
            <li class="active">Mesajlar listesi</li>
        </ol>
    </section>

    <section class="content">
        <div class='row'>
            <div class='col-xs-12'>
                <div class='box box-info'>

                    <div class="col-md-12">
                        <br />
                        <div class="lbl-cnt">
                            <div class="fld inline">
                                <div class="dropdown dropdown-small dropdown-med dropdown-white inline">
                                    <button data-toggle="dropdown" type="button" class="btn btn-default dropdown-toggle">
                                        Filtreleme seçenekleri ile sýrala...
                                        <span class="caret"></span>
                                    </button>
                                    <ul role="menu" class="dropdown-menu">

                                        <li role="presentation">
                                            <a href="/Mesajlars/Index?mesajturu=0">Cevaplanmadý</a>
                                        </li>

                                        <li role="presentation">

                                            <a href="/Mesajlars/Index?mesajturu=1">Cevaplandý</a>
                                        </li>
                                        <li role="presentation">
                                            <a href="/Mesajlars/Index?mesajturu=2">Tümü</a>

                                        </li>
                                        

                                    </ul>
                                </div>
                            </div><!-- /.fld -->
                        </div><!-- /.lbl-cnt -->


                        <hr />
                        <!-- tools box -->
                    </div><!-- /.box-header -->

                
                    <div class="box-body table-responsive" style="overflow:hidden">
                        <table id="tblListe" class="table table-bordered table-striped">


                            <thead>
                                <tr>
                                    <th></th>
                                    <th>
                                        Gönderen
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.mesaj)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.tarih)
                                    </th>
                                    <th>

                                    </th>

                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <a href="@Url.Action("Details", "Mesajlars", new { uyeid = item.gonderenId, urunid = item.spId, urunadi = item.urunadi })">Mesaja git</a> | 
                                            @Html.ActionLink("Sil", "Delete", new { aid = item.id })
                                        </td>
                                        <td>
                                            @item.uyeadi
                                        </td>
                                        <td style="max-width:200px">
                                            @item.mesaj.TrimFrontIfLongerThan(100)
                                        </td>
                                        <td>
                                            @String.Format("{0:g}", item.tarih)
                                        </td>
                                        <td>
                                            @if (item.okundumuAdmin)
                                            { <label>Cevaplandý</label>}
                                            else
                                            { <label><u>Cevaplanmadý</u></label> }

                                        </td>
                                    </tr>
                                }
                            <tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>
</aside>
@section scriptFooter{

    @Scripts.Render("~/bundles/datatables")

    <script src="~/Scripts/plugins/datatables/dataTablesConfigurations.js"></script>



}


