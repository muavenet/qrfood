
@model HemenTanitim.Models.MailAyarlari

@using Resources;



@{
    ViewBag.Title = "Index";
          Layout = "~/Views/Shared/Admin.cshtml";

}

<style>
    .text-center{text-align:left}
</style>	


<aside class="right-side">

    <section class="content-header">
        <h1>
            Mail Ayarlarý
        </h1>
        <ol class="breadcrumb">
            <li><a href="@Url.Action("Index","AdminDasboard")"><i class="fa fa-dashboard"></i> Anasayfa</a></li>
            <li class="active">Mail Ayarlari listesi</li>
        </ol>
    </section>

    <section class="content">
        <div class='row'>
            <div class='col-md-12'>
                <div class='box box-purple'>

                    <div class='box-header'>
                        <h3 class='box-title'><a href="@Url.Action("Edit", new { aid = Model.id })">D&#252;zenle</a></h3>
                    </div>



                    <div class="box-body">
                        <div class="box-body table-responsive" style="overflow:hidden">
                        <table id="tblListe" class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th class="col-md-2">Ba&#351;l&#305;klar</th>
                                        <th>&#304;&#231;erikler</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    <tr>
                                        <td>
                                            <label>@Html.LabelFor(model => model.mailAdresi)</label>
                                        </td>
                                        <td>
                                            @Model.mailAdresi
                                        </td>
                                    </tr>


                                    <tr>
                                        <td>
                                            <label>@Html.LabelFor(model => model.mailSifresi)</label>
                                        </td>
                                        <td>
                                            @Model.mailSifresi
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>
                                            <label>@Html.LabelFor(model => model.mailgelecekAdres)</label>
                                        </td>
                                        <td>
                                            @Model.mailgelecekAdres
                                        </td>
                                    </tr>


                                    <tr>
                                        <td>
                                            <label>@Html.LabelFor(model => model.smptClient)</label>
                                        </td>
                                        <td>
                                            @Model.smptClient
                                        </td>
                                    </tr>


                                    <tr>
                                        <td>
                                            <label>@Html.LabelFor(model => model.port)</label>
                                        </td>
                                        <td>
                                            @Model.port
                                        </td>
                                    </tr>



                                    

                                </tbody>
                            </table>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</aside>

<script type="text/javascript">
    $(document).ready(function () {
    
        $("#ayarlar_mail").addClass("active");
      
    });


</script>