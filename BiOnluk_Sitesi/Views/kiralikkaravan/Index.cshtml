<head>

    @{
        string degertirnak = "\"articleBody\" : \"\",";

        <script type="application/ld+json">
    {
    "@@context" : "http://schema.org",
    "@@type" : "Article",

    @if (Model.il_ad != null)
    {
        @Html.Raw("\"name\" : \"" + Model.Kelime_adi + ",-, Kiralık Karavan " + Model.il_ad + "\",");
    }
    else
    {
        @Html.Raw("\"name\" : \"" + Model.Kelime_adi + ",-, Kiralık Karavan\",");
    }

    "author" : {
    "@@type" : "Person",
    "name" : "Ciravan"
    },
    "image" : "http://www.Kiralık Karavan.com.tc/Content/images/Kiralık Karavan-memduh.jpg",
    "articleSection" : "@Model.Kelime_adi Karavan Kiralama ",


     @if (Model.Icerik != null)
     {
         if (Model.il_ad != null)
         {
             @Html.Raw("\"articleBody\" : \"" + Model.Icerik.TrimFrontIfLongerThan(500) + Model.il_ad + "\",");

         }
         else
         {
             @Html.Raw("\"articleBody\" : \"" + Model.Icerik.TrimFrontIfLongerThan(500) + "\",");
         }


     }
     else
     {
         @Html.Raw(degertirnak);
     }

    "url" : "@Request.Url.ToString()",
    "publisher" : {
    "@@type" : "Organization",
    "name" : "Kiralık Karavan"
    }
    }
        </script>

    }



    @if (Model.ilce_ad != null)
    {
        <title>@Model.Kelime_adi, -, Kiralık Karavan @Model.ilce_ad</title>

        <meta name="description" content="Kiralık Karavan @Model.ilce_ad Karavan Kiralama. Ciravan, Karavan kiralık" />
        <meta name="keywords" content="@Model.ilce_ad Kiralık Karavan, @Model.ilce_ad un toptancısı, Kiralık Karavan @Model.ilce_ad,  @Model.Kelime_adi, Ciravan, @Model.ilce_ad un seçenekleri, @Model.Kelime_adi Karavan Kiralama" />
        <meta content="General" name="rating" />
    }

    else if (Model.il_ad != null)
    {
        <title>@Model.Kelime_adi,  -, Kiralık Karavan @Model.il_ad</title>

        <meta name="description" content="Kiralık Karavan @Model.il_ad Karavan Kiralama. Ciravan, Karavan kiralık" />
