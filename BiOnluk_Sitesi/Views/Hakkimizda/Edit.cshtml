@model HemenTanitim.Models.Hakkimizda
@using Resources;
@{
    ViewBag.Title = "Edit düzenleme";
    Layout = "~/Views/Shared/Admin.cshtml";
}


<aside class="right-side">
    <section class="content-header">
        <h1>
           Hakkımızda

        </h1>
        <ol class="breadcrumb">
            <li><a href="@Url.Action("Dasboard")"><i class="fa fa-dashboard"></i> Anasayfa</a></li>
            <li class="active">Hakkımızda  d&#252;zenle</li>
        </ol>
    </section>

    <section class="content">
        <div class='row'>
            <div class='col-md-12'>
                <div class='box box-purple'>

                    <div class="box-body">



                        @using (Html.BeginForm("Edit", "Hakkimizda", FormMethod.Post, new { @class = "form-horizontal", @id = "block-validate", enctype = "multipart/form-data" }))
                        {

                            @Html.ValidationSummary(true)

                            @Html.HiddenFor(model => model.Id)
                            
                            
                             <div class="form-group">
                                <div class="col-lg-12">
                                    @Html.LabelFor(model => model.Baslik)<br />
                                    @Html.TextBoxFor(model => model.Baslik, new { @class = "form-control", data_toggle = "tooltip", data_placement = "top", title = "Tooltip on top" })
                                    @Html.ValidationMessageFor(model => model.Baslik)
                                </div>

                            </div>
                           
                            <div class="form-group">
                         
                                <div class="col-lg-12">@Html.LabelFor(model => model.Icerik)<br />
                                    @Html.TextAreaFor(model => model.Icerik, new { @class = "form-control", data_toggle = "tooltip", data_placement = "top", title = "Tooltip on top" })
                                    @Html.ValidationMessageFor(model => model.Icerik)
                                </div>

                            </div>



                            <div class="form-actions no-margin-bottom" style="text-align:left;">
                                <input type="submit" value="Kaydet" class="btn btn-primary btn-lg " />
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div>
            <a href="@Url.Action("Index")">Listeye d&#246;n</a>
        </div>
    </section>
</aside>

@section scriptFooter{
 <script src="~/Scripts/plugins/ckeditor/ckeditor.js"></script>
    <script>

        $(document).ready(function () {

          
                CKEDITOR.replace('Icerik',
             {

                 height: '200px'
             });

            $("li").removeClass("active");
            $("#ayarlar").addClass("active");
            $("#ayarlar_menu").css("display", "block");
            $("#ayarlar_hakkimizda").addClass("active");
            $("#ayarlar_arrow").addClass("fa-angle-down");

            $("#wysihtml5").wysihtml5();

        });
    </script>
}

