<script>
    $(document).ready(function () {
        $("li").removeClass("active");
        $("#urunler").addClass("active");
        $("#urunler_menu").css("display", "block");
        $("#urunler_liste").addClass("active");
        $("#urunler_arrow").addClass("fa-angle-down");
    });
</script>


}