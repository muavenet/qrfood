@{
	ViewBag.Title = "Sepet";
	Layout = null;
}



@*<link rel="stylesheet" href="Content/assets/css/config.css">*@



	<script src="http://code.jquery.com/jquery-3.5.0.min.js" integrity="sha256-xNzN2a4ltkB44Mc/Jz3pT4iU1cmeR0FkXs4pru/JxaQ=" crossorigin="anonymous"></script>

	<script src="~/scripts/knockout-2.1.0.js" type="text/javascript"></script>
	<script src="~/scripts/jquery-ui-1.8.20.js" type="text/javascript"></script>

	<script src="~/js/utils.js" type="text/javascript"></script>
	<script src="~/js/ajaxservice.js" type="text/javascript"></script>
	<script src="~/js/dataservice.shopping.js" type="text/javascript"></script>
	<script src="~/js/sepet_index.js"></script>






<div class="ads-info">
	<div class="row">
		<div class="col-md-9">
			<div class="my-reks section" data-bind=" foreach : sepets">
				<div class="col-md-7 no-gutter">
					<h4 class="display-3" style="display:inline-block">
						<a data-bind="attr: { href:Url}">
							<span data-bind="text: IlanAdi"></span>
						</a>
					</h4>
				</div>

				<div class="col-md-5 text-right">
					<h4 class="ustAlan_sepet">
						Adet :
						<input data-bind="value: quantity, valueUpdate:'afterkeydown', jqButton: { }, click: $root.placeOrder"
							   type="number" max="10" min="1" 
							   class="integerInput form-control" style="width: 79px; display:inline-block; margin-right:10px" />
					
						<strong>
							<span data-bind="text: OrdersApp.formatCurrency(fiyat())" class="cart-sub-total-price"></span>
							
							@*<span style="font-weight:400"; data-bind="text:  AySayisi() > 0 ? 'x (' + AySayisi() + ' gün)': ''  "
								  class="cart-sub-total-price"></span>*@
						</strong>
						@*<span class="right">
                                

								<strong><span class="cart-sub-total-price" data-bind="text: OrdersApp.formatCurrency(fiyat())"></span></strong>
							</span>*@
					</h4>

				</div>


				<div class="col-md-12 text-right">
					<hr />
				</div>

				<!-- ad-item -->


                <div class="adm-item row" style="margin-bottom:20px">
                    <!-- item-image -->

                    <div class="item-image-box col-sm-3">
                        <div class="item-image">

                            <a data-bind="attr: { href:Url}">
                                <img data-bind="attr:{src: IlanFoto}" alt="" class="img-responsive" id="foto" style="height:115px">
                            </a>
                        </div><!-- item-image -->
                    </div>

                    @if (!Request.Browser.IsMobileDevice)
                    {
                        <div class="item-info col-sm-9" id="module">
                            <div class="adm-info">
                                <div class="col-md-12">
                                    <span data-bind="text: IlanAciklama"></span>
                                </div>
                                <div class="col-md-12">
                                    <br />
                                    <strong>Note</strong>
                                    <textarea class="form-control" data-bind="value : Not" placeholder="Write what you want to convey as extra"></textarea>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <style>
                            #iyzipay-checkout-form {
                                text-align: left;
                                position: fixed;
                                top: 15px;
                                left: 10px;
                                right: 10px;
                                background-color: white;
                                z-index: 99999;
                            }

                            .active {
                                background-color: inherit !important;
                            }

                            .form-horizontal .form-group {
                                margin-left: -5px;
                                margin-right: -5px;
                                margin-bottom: -10px;
                            }

                            #foto {
                                height: 181px !important;
                            }

                            .myads-page .my-reks {
                                padding: 15px 17px;
                            }

                            #module {
                                font-size: 1em;
                                line-height: 2;
                                padding-left: 0;
                            }

                                #module #collapseExample.collapsing {
                                    height: 3rem;
                                }

                                #module a.collapsed::after {
                                    content: '+ Detayı Gör';
                                }

                                #module a:not(.collapsed)::after {
                                    content: '- Detayı Kapat';
                                }
                        </style>

                        <div id="module" class="container">
                            <p class="collapse" id="collapseExample" aria-expanded="false" data-bind="text: IlanAciklama">
                            </p>
                            <a role="button" class="collapsed" data-toggle="collapse" href="#collapseExample" aria-expanded="false" aria-controls="collapseExample"></a>
                        </div>

                        <div id='jqbox_overlay'></div>
                    }


					
                    <a class="btn btn-default btn-lg padd" @*data-bind="enable: sepets().length > 0, click: $root.placeOrder"*@
                       data-bind="jqButton: { }, click: $root.removeFromCart">                      
                        Remove
                    </a>

                    <a class="btn btn-default btn-lg padd pull-right" @*data-bind="enable: sepets().length > 0, click: $root.placeOrder"*@
                       data-bind="valueUpdate:'afterkeydown', jqButton: { }, click: $root.placeOrderSepetNot">                     
                        Update Basket
                    </a>



                </div>
			</div>
		</div>

		<div class="col-sm-3 ">
		
			<div class="ads-info">
				<div class="row">
					<div class="col-sm-6 col-md-12">
						<div class="my-reks section">
							<div class="form-horizontal" data-bind=" foreach : sepets.slice(0,1)">

								<div style="text-align:center;padding-bottom:20px;">
									@*<img src="/Content/uploads/Profil_fotograflari/@Model.Fotograf"
										alt="Alternate Text" style="border-radius: 50%;    width: 104px;height: 97px; border: 6px solid #ececec; " />*@
								</div>

								<div class="form-group">
									<div class="col-md-12 text-center padding-bottom-20">
										<h3>Payment Summary</h3>
									</div>

									@*<div class="col-md-8 col-xs-8 padding-bottom-20">
										Teslimat Zamanı&nbsp;
									</div>
									<div class="col-md-4 col-xs-4  padding-bottom-20 text-right">
										<strong><span data-bind="text: teslimatSuresi"></span> Gün</strong>
									</div>*@

									<div class="col-md-5 col-xs-6 padding-bottom-20">
										<h4>Total</h4>
									</div>
									<div class="col-md-7 col-xs-6 padding-bottom-20 text-right" id="fiyatmobile">
                                        <h4>	<strong><span class="inner-left-md"
															  data-bind="text:OrdersApp.formatCurrency(grandTotal())"></span></strong></h4></div>

								</div>

                                <div class="form-group text-center">
                                    <a class="btn btn-default btn-lg padd" @*data-bind="enable: sepets().length > 0, click: $root.placeOrder"*@
                                       data-bind="jqButton: { }, click: $root.IlansiparisGir" id="btnTamamla" >



                                        <i class="fa fa-spinner fa-spin" style="display:none;" id="spin_i"></i>

                                        Place an order
                                    </a>
							
                                    <a class="btn btn-default btn-lg" style="margin-top:15px;" @*data-bind="enable: sepets().length > 0, click: $root.placeOrder"*@
                                       data-bind="jqButton: { }, click: $root.IlansiparisGir" id="btnTamamla_Cash">
                                        <i class="fa fa-spinner fa-spin" style="display:none;" id="spin_i_"></i>

                                        Cash on delivery
                                    </a>


                                    <div id="iyzipay-checkout-form" class="popup">

                                    </div>
                                    <br /><br />


                                    <i class="fa fa-expeditedssl" style="color:green; font-size:22px"></i>
                                    <span style="font-size: 17px;font-weight: 500;">SSL Security Paymnet</span>
                                    <br />
                                    <small>	256-bit SSL Certificate</small>
                                </div>
							</div>



							@*<section id="externalLogins">
									@Html.Action("RemoveAccountList")
									@Html.Partial("_ExternalLoginsListPartial", new HemenTanitim.Models.ExternalLoginViewModel() { Action = "LinkLogin", ReturnUrl = ViewBag.ReturnUrl })
								</section>*@



						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>









