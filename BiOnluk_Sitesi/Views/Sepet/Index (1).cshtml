@{
    ViewBag.Title = "Sepet";
    Layout = null;
}



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Askbootstrap">
    <meta name="author" content="Askbootstrap">
    <link rel="icon" type="image/png" href="img/logo.png">
    <title>TYP - Online Food Ordering</title>
    <!-- Slick Slider -->
    <link rel="stylesheet" type="text/css" href="~/Content/UI/vendor/slick/slick.min.css" />
    <link rel="stylesheet" type="text/css" href="~/Content/UI/vendor/slick/slick-theme.min.css" />
    <!-- Feather Icon-->
    <link href="~/Content/UI/vendor/icons/feather.css" rel="stylesheet" type="text/css">
    <!-- Bootstrap core CSS -->
    <link href="~/Content/UI/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <!-- Custom styles for this template -->
    <link href="~/Content/UI/css/style.css" rel="stylesheet">
    <!-- Sidebar CSS -->
    <link href="~/Content/UI/vendor/sidebar/demo.css" rel="stylesheet">

</head>
<body class="bg-light fixed-bottom-bar">
    <div id="iyzipay-checkout-form" class="pop-up"></div>
    <div class="osahan-checkout">
        <div class="p-3 osahan-inner-header bg-white shadow-sm">
            <div class="d-flex align-items-center">
                <a class="font-weight-bold text-dark text-back text-decoration-none " href="/">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="back-page bi bi-chevron-left" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"></path>
                    </svg>
                </a>
                <span class="ml-3 h6 mb-0">Order</span>
                <div class="ml-auto d-flex align-items-center">
                    @*<a class="text-dark mx-2 top-nav-btn top-nav-btn-cart fs-18 position-relative" href="checkout.html"><i class="feather-shopping-bag"></i> <span>3</span></a>*@
                    <a class="toggle ml-2 text-dark hc-nav-trigger hc-nav-1" href="#" role="button" aria-controls="hc-nav-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-list" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M2.5 11.5A.5.5 0 0 1 3 11h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4A.5.5 0 0 1 3 7h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4A.5.5 0 0 1 3 3h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"></path>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
        <!-- checkout -->
        <div class="py-3 osahan-cart-item" data-bind=" foreach : sepets">
            <div class="d-flex align-items-center osahan-cart-item-profile bg-white shadow p-3">
                <img alt="osahan" data-bind="attr:{src: IlanFoto}"
                     class="mr-3 rounded-circle img-fluid"
                     style="min-height: 60px; max-width: 65px; ">
                <div class="osahan-cart-item-profile-body">
                    <h6 class="mb-1 font-weight-bold pt-1" data-bind="text: IlanAdi"></h6>
                    <p class="mb-0 small text-muted" data-bind="text: OrdersApp.formatCurrency(fiyat())"><i class="feather-map-pin"></i></p>
                    <a href="#" class="" @*data-bind="enable: sepets().length > 0, click: $root.placeOrder"*@
                       data-bind="jqButton: { }, click: $root.removeFromCart">
                        X Remove from cart
                    </a>
                </div>
            </div>
            <div class="bg-white shadow">
                <div class="gold-members d-flex align-items-center justify-content-between px-3 py-2 border-bottom">
                    <div class="media align-items-center">
                        <div class="mr-2 text-danger">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-circle-fill" viewBox="0 0 16 16">
                                <circle cx="8" cy="8" r="8" />
                            </svg>
                        </div>
                        <div class="media-body">
                            <p class="m-0">Quantity</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <div class="osahan-quantity">
                            @*<input type="text" name="quantity" value="1" title="Qty" class="qty"
                            data-bind="value: quantity, valueUpdate:'afterkeydown', jqButton: { }, click: $root.placeOrder">*@

                            <input type="text" name="quantity" value="1" title="Qty" class="qty"
                                   data-bind="value: quantity">

                        </div>

                    </div>
                </div>

            </div>
            <div class="mb-3 shadow bg-white p-3 py-3 clearfix">
                <div class="mb-0 input-group">
                    <div class="input-group-prepend"><span class="input-group-text"><i class="feather-message-square"></i></span></div>
                    <textarea placeholder="What you want to add to the order..." aria-label="With textarea" class="form-control" data-bind="value : Not"></textarea>
                    <div class="input-group-append"><button id="button-addon2" type="button" class="btn btn-primary" data-bind="valueUpdate:'afterkeydown', jqButton: { }, click: $root.placeOrderSepetNot"><i class="feather-percent"></i> APPLY</button></div>
                </div>
            </div>
            <hr />
        </div>

        <div class="py-3 osahan-cart-item sakla_totals" data-bind=" foreach : sepets.slice(0,1)" >
            <div class="fixed-bottom p-3" style="bottom:55px !important;">
                <a data-bind="jqButton: { }, click: $root.siparisGirKapidaOdeme"
                   class="btn btn-danger btn-block btn-sm text-white rounded shadow text-decoration-none d-flex align-items-center shadow">
                    <div class="border-right pr-3">
                        <h4 class="m-0"><i class="feather-shopping-bag" aria-hidden="true"></i></h4>
                    </div>
                    <div class="ml-3 text-left">
                        <p class="mb-0 small text-white-50" data-bind="text: ToplamSepetAdet()"> </p>
                        <p class="mb-0 font-weight-bold text-white" data-bind="text:OrdersApp.formatCurrency(grandTotal())"></p>
                    </div>
                    <div class="ml-auto">
                        <p class="mb-0 text-white">
                            Cash On Delivery <i class="feather-chevron-right pl-2" aria-hidden="true"></i>
                        </p>
                    </div>
                
                </a>
            </div>
        </div>

        <div class="py-3 osahan-cart-item sakla_totals" data-bind=" foreach : sepets.slice(0,1)">
            <div class="fixed-bottom p-3">
                <a data-bind="jqButton: { }, click: $root.IlansiparisGir"
                   class="btn btn-success btn-block btn-sm text-white rounded shadow text-decoration-none d-flex align-items-center shadow">
                    <div class="border-right pr-3">
                        <h4 class="m-0"><i class="feather-shopping-bag" aria-hidden="true"></i></h4>
                    </div>
                    <div class="ml-3 text-left">
                        <p class="mb-0 small text-white-50" data-bind="text: ToplamSepetAdet()"> </p>
                        <p class="mb-0 font-weight-bold text-white" data-bind="text:OrdersApp.formatCurrency(grandTotal())"></p>
                    </div>
                  
                    <div class="ml-auto">
                        <p class="mb-0 text-white">
                            CREDIT CART <i class="feather-chevron-right pl-2" aria-hidden="true"></i>
                            <i class="fa fa-spinner fa-spin" style="display:none;" id="spin_i"></i>
                        </p>
                    </div>
                </a>
            </div>
        </div>


    </div>

    @Html.Partial("_LoginPartial")
    <!-- Bootstrap core JavaScript -->


    <script src="http://code.jquery.com/jquery-3.5.0.min.js" integrity="sha256-xNzN2a4ltkB44Mc/Jz3pT4iU1cmeR0FkXs4pru/JxaQ=" crossorigin="anonymous"></script>
    <script src="~/scripts/knockout-2.1.0.js" type="text/javascript"></script>
    <script src="~/scripts/jquery-ui-1.8.20.js" type="text/javascript"></script>

    <script src="~/js/utils.js" type="text/javascript"></script>
    <script src="~/js/ajaxservice.js" type="text/javascript"></script>
    <script src="~/js/dataservice.shopping.js" type="text/javascript"></script>
    <script src="~/js/sepet_index.js"></script>



    <script src="~/Content/UI/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- slick Slider JS-->
    <script type="text/javascript" src="~/Content/UI/vendor/slick/slick.min.js"></script>
    <!-- Sidebar JS-->
    <script type="text/javascript" src="~/Content/UI/vendor/sidebar/hc-offcanvas-nav.js"></script>
    <!-- Custom scripts for all pages-->
    <script src="~/Content/UI/js/osahan.js"></script>


</body>
</html>











