@if (ViewContext.RouteData.Values.Keys.Contains("anaKategoriAdi"))
{
    @Html.Hidden("hdnanaKategoriAdi", ViewContext.RouteData.Values["anaKategoriAdi"].ToString())
    @Html.Hidden("hdnanaKategoriId", ViewContext.RouteData.Values["anaKategoriId"])
    @Html.Hidden("hdnanaAltKategoriAdi", ViewContext.RouteData.Values["AltKategoriAdi"].ToString())
    @Html.Hidden("hdnanaAltKategoriId", ViewContext.RouteData.Values["AltKategoriId"])
}

@section scripts{
    <script>

        var $fArama = jQuery.noConflict();

        $fArama('.currency').on('keyup', function () {
            jQuery(this).val(jQuery(this).val().split('.').join(''));
            jQuery(this).val((jQuery(this).val()).replace(/\B(?=(?:\d{3})+(?!\d))/g, "."));

        });

        $fArama('#FiltreteGoreArama').click(function () {

            //alert($fArama("#arananKelime").val());

            var minfiyat = $fArama("#minfiyat").val().replace(/\./g, "");
            var maxfiyat = $fArama("#maxfiyat").val().replace(/\./g, "");
            var minAlexa = $fArama("#minAlexa").val().replace(/\./g, "");
            var maxAlexa = $fArama("#maxAlexa").val().replace(/\./g, "");
            var dmozDegeri = $fArama('input[name=dmozKaydi]:checked').val();
            var newsDegeri = $fArama('input[name=newsKaydi]:checked').val();

            if (minfiyat == "")
                minfiyat = 0;

            if (maxfiyat == "")
                maxfiyat = 0;

            if (minAlexa == "")
                minAlexa = 0;

            if (maxAlexa == "")
                maxAlexa = 0;


            var url = "/UrunListesi/FiltreliUrunler/" + $fArama("#hdnanaKategoriAdi").val() + "/" + $fArama("#hdnanaKategoriId").val() + "/" + $fArama("#hdnanaAltKategoriAdi").val() + "/" + $fArama("#hdnanaAltKategoriId").val() + "/" + minfiyat + "/" + maxfiyat + "/" + minAlexa + "/" + maxAlexa + "/" + dmozDegeri + "/" + newsDegeri + "/en_yeniler" + "";

            window.location.href = url;

            return false;
        });

        function checkOffset() {
            if ($fArama('#hesaplanacakAccord').offset().top + $fArama('#hesaplanacakAccord').height() >= $fArama('#yaz').offset().top - 10) {

                $fArama('#hesaplanacakAccord').css('display', 'block');
            }

            if ($fArama('#hesaplanacakAccord').offset().top + $fArama('#hesaplanacakAccord').height() >= $fArama('#AramaButonuFixedSon').offset().top - 10) {
                $fArama('#hesaplanacakAccord').css('position', 'absolute');
            }

            if ($fArama(document).scrollTop() + window.innerHeight < $fArama('#AramaButonuFixedSon').offset().top) {
                $fArama('#hesaplanacakAccord').css('position', 'fixed');  // restore when you scroll up
            }

            //$fArama('#hesaplanacakAccord').text($fArama(document).scrollTop() + window.innerHeight);
        }

        $fArama(document).scroll(function () {
            checkOffset();
        });

        
    </script>
}

