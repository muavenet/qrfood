@model List<HemenTanitim.Models.FavoriUrunlerFotolarla>

@{
	ViewBag.Title = "FavoriUrunlerim";
	Layout = "~/Views/Shared/_LayoutMusteriPaneli.cshtml";
}



@Styles.Render("~/Content/css/datatables")
@Styles.Render("~/Content/css/datatables_With_Image")

<style>
	.text-center {
		text-align: left;
	}

	thead {
		display: none
	}
	#favoriler_active_link, #favoriler_active_link a, #favoriler_active_link small {
		background: green;
		color: white;
	}
</style>

<div class="ads-info">
	<div class="row">

		@if (!Request.Browser.IsMobileDevice)
		{
			<div class="col-sm-4 ">
				<!-- recommended-cta -->
				@{Html.RenderAction("BilgileriDegistir_PartialView", "MusteriPaneli");}

			</div>
		}

		<div class="col-sm-8">
			<div class="my-reks section">
				<table id="tblListe" class="table table-bordered table-striped">
					<thead>
						<tr>
							<th></th>
							<th></th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in Model)
						{
							<tr data-href="@Url.Action("Index", "UrunDetay", new { urunAdi = item.UrunAdi.ToSeoUrl().Trim(), isId = item.isId })">
								<td>
									<a href="#"><img src="@item.ResimYolu" alt="@item.UrunAdi" height="50" /></a>
								</td>
								<td style="vertical-align:middle">
									@item.UrunAdi
								</td>

								<td style="vertical-align:middle;text-align:right !important;">
									@*<a href="@Url.Action("Index", "UrunDetay", new { id = item.UrunId })" class="btn btn-success" onclick="return confirm('Kaydını silmek istediğinize emin misiniz ?');">Sitenin detayına git</a>*@
									<a href="@Url.Action("FavoriUrunSil", "MusteriPaneli", new { uid = item.FavoriUrunId })"
									   class="btn btn-default" onclick="return confirm('Kaydını silmek istediğinize emin misiniz ?');"><i class="icon fa fa-times"></i>&nbsp Kaldır</a>
								</td>
							</tr>
						}
					<tbody>
				</table>


			</div>
		</div>

	</div>
</div>
@section scripts{

	@Scripts.Render("~/bundles/datatables")

	<script src="~/Scripts/plugins/datatables/dataTablesConfigurations_With_Images.js"></script>

	<script>

		var $dhref = jQuery.noConflict();

		$dhref('tr[data-href]').on("click", function () {
			document.location = $dhref(this).data('href');
		});
	</script>
}

