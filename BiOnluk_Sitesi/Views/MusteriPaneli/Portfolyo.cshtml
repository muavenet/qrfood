
@{
    ViewBag.Title = "Portfolyo";
    Layout = "~/Views/Shared/_LayoutMusteriPaneli.cshtml";
}



<style>
	.nav-pills > li.active > a, .nav-pills > li.active > a:focus, .nav-pills > li.active > a:hover
	.select-category > li > a {
		display: inline !important;
	}
	.select-category li:before {
		position: absolute;
		top: 0 !important;
		right: 0;
		font-size: 15px;
		content: "\f105";
		font-family: 'FontAwesome';
		color: #00a651;
		opacity: 0;
	}
	.postdetails li .IsIlanlari_a {
		font-family: 'Ubuntu', sans-serif !important;
		font-size: 15px !important;
		font-weight: 400 !important;
		padding: 15px 0px !important;
	}
	.section {
		background-color: white;
	}
	.selected-product .select-category li:before {
		top: 6px !important
	}
</style>

@if (Request.Browser.IsMobileDevice)
{
	<style>
		.selected-product .select-category li:before {
			top: 5px !important;
			right: 4px;
			opacity: 1;
		}
		.selected-product .select-category li.active {
			padding-left:0;
		}



        #pr_content {
            float: left;
            border: 1px solid #ebebeb;
        }

        #preview {
			height:94px !important;
		}
        #pr_content canvas, #pvi {
            width: 87px !important;
            height: 70px !important;
        }

	</style>
}



<section id="main" class="clearfix details-page">
	<div class="row">

	
		<div class="col-md-12">
			<div class="section postdetails box-shadow-genel">
				@* <h4>Sell an item or service <span class="pull-right">* Mandatory Fields</span></h4>*@
				<div class="form-group selected-product" id="rootwizard">


					<form id="formIcerik" action="" method="post">

						<div class="tab-content">

							<div id="loadgifdiv" style="width:100%; text-align:center; margin-top:15px" class="center"></div>

							<div class="tab-pane  fade active in" id="tab4">
								<div class="row form-group add-image">

                                    <div class="col-sm-12">

                                        <a id="tooltip" class="tooltip" style="visibility:hidden; left:237px; margin-top:17px; " href="#" title="Kapak resmi">
                                            <img src="~/Content/Resim_Editor/images/icons/kapak.png" />
                                        </a>


                                        <div id="preview" style="width:99%; float:none; padding-left:0;">
                                            <div id="resimUp">

                                                <label class="upload-image" for="upload-image-two">
                                                    <input type="file" id="upload-image-two" name="file[]" multiple onchange="javascript:handleFileSelectBtn(event)">

                                                </label>

                                            </div>

                                            <span>Resim Ekle</span>
                                            <span class="small">(PNG, JPG)</span>
                                            <span class="small">Yüklenen dosya <br /> <span id="dosya_adet"></span> / 16 </span><br />
                                            <progress value="0" max="8" style="width: 130px" id="progress_file"></progress>


                                        </div>

                                        <div id="progress_bar" style="position:relative; bottom:0px;width:100%; right:0px; "><div class="percent">0%</div></div>

                                        <div id="pr_content" class="pr_content">
                                        </div>


                                        <div class="col-md-12" style="padding:1px">

                                            <img src="~/Content/Resim_Editor/images/ilanver_load.GIF" width="40"
                                                 alt="Yükleniyor" id="load_ilanver" style="visibility:hidden;" title="Bekleyiniz" />

                                            <style>
                                                #btnDevam:focus ~ #spin_i {
                                                    display: inline-block !important;
                                                }
                                                }
                                            </style>

                                            <ul class="pager wizard">
                                                @*<li class="previous"><a href="#">Geri Dön</a></li>*@

                                                <li>

                                                    <a href="#" class="btn btn-default" onclick="servisGonder('param1');" id="btnDevam" tabindex="0">
                                                        Kaydet
                                                    </a>
                                                    <i class="fa fa-spinner fa-spin" style="display:none;" id="spin_i"></i>
                                                </li>
                                            </ul>


                                        </div>


                                        @if (@HttpContext.Current.Request.RequestContext.RouteData.Values["id"] != null)
                                        {
                                            <input type="hidden" value='@HttpContext.Current.Request.RequestContext.RouteData.Values["id"]' id="routeDataId" />
                                            <script src="~/js/Resim_Editor_Edit.js"></script>
                                        }
                                        else
                                        {
                                            <script src="~/js/Resim_Editor_Create.js"></script>
                                        }

                                        <link href="~/Content/Resim_Editor/resim_dondur.css" rel="stylesheet" />

                                        <div id="cerceve_arka">
                                            <div id="cerceve">
                                                <div id="icerik">
                                                    <div id="serit">

                                                        @*<input type="button" id="btnVitrin" title="Vitrin" value="Vitrin yap" />*@
                                                        <input type="button" id="btnDondur" value="    Dondur" />
                                                        <input type="button" id="btnGom" value="    Kaydet" />
                                                        <input type="button" id="btnVazgec" value="    Vazgeç" />
                                                    </div>
                                                    <div style="clear:both;"></div>
                                                    <div id="resim"></div>
                                                    <div id="canvas_div">
                                                        <img id="rot_image" width="480" height="360" />
                                                    </div>


                                                </div>
                                            </div>
                                        </div>


                                    </div>
								</div>


							</div>

							<div class="tab-pane " id="tab5">
								<div class="row form-group add-image">

									<div class="col-sm-12">
										<div class="row form-group add-image">
											<div class="congratulations">
												<i class="fa fa-check-square-o"></i>
												<h2>İlan Taslağınız Oluşturuldu!</h2>
												<h4>İlanınız onaylandıktan sonra yayına alınacaktır.</h4>
											</div>

											<ul class="pager wizard">
												@*<li class="previous"><a href="#">Geri Dön</a></li>*@
												<li>
													<a href="#" class="btn btn-large animate-flicker" style="color:black">
														Yönlendiriliyorsunuz ...
														@*İş İlanlarım&nbsp;&nbsp; <span class="glyphicon glyphicon-arrow-right"></span>*@
													</a>
												</li>
											</ul>
										</div>
									</div>
								</div>
							</div>


						</div>
					</form>
				</div>
			</div>
		</div>


	</div>
</section>


