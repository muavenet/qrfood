@model HemenTanitim.Models.IsIlanlari

@{
	ViewBag.Title = "IsIlanlari_Duzenle_Devami";
	Layout = "~/Views/Shared/_LayoutMusteriPaneli.cshtml";
}



<style>
	.nav-pills > li.active > a, .nav-pills > li.active > a:focus, .nav-pills > li.active > a:hover {
		background-color: transparent !important;
		color: #00a651 !important;
	}

	.select-category > li > a {
		display: inline !important;
	}

	.postdetails li .IsIlanlari_a {
		font-family: 'Ubuntu', sans-serif !important;
		font-size: 15px !important;
		font-weight: 400 !important;
	}

	.section {
		background-color: white;
	}

	
	.pager li > a, .pager li > span {
		border-radius: 0;
		padding: 12px 42px;
	}

</style>

@if (Request.Browser.IsMobileDevice)
{
	<style>
        .nav li a, .navbar-default .navbar-nav > li > a {
			padding:0px 12px !important;
		}
        .selected-product .select-category li:before {
            top: 5px !important;
            right: 4px;
            opacity: 1;
        }
		.selected-product .select-category li.active {
			padding-left:0;
		}
        .selected-product .select-category li {
            display: grid;
			width:100%;
        }

        .displaytelefon {
            display: none !important;
        }
	</style>
}



<section id="main" class="clearfix details-page">
	<div class="row">

		@if (!Request.Browser.IsMobileDevice)
		{
			<style>
				label {
					font-size: 11px !important;
				}

				.col-md-6 strong, .col-md-4 strong {
					font-size: 13px !important;
				}
              
			</style>

			<div class="col-sm-3 ">
