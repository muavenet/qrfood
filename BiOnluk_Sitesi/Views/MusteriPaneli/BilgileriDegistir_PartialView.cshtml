@model HemenTanitim.Models.BilgeriDegistir

@using Microsoft.AspNet.Identity;


<style>
	.padding-left-0 {
		padding-left: 0 !important
	}
	.padding-bottom-20 {
	padding-bottom:20px;
	}
	.form-horizontal .control-label {
		text-align:left;
		padding-top:0 !important;
	}
</style>

<div class="ads-info">
    <div class="row">
		<div class="col-sm-6 col-md-12">
			<div class="my-reks section">
				<div class="form-horizontal">
					<p class="text-success">@ViewBag.StatusMessage</p>

					<div class="col-md-12 padding-left-0">
						<div class="user-option pull-left">
							<strong>
								<a class="edit-item" href="/MusteriPaneli/BilgileriDegistir_Anasayfa" data-toggle="tooltip" data-placement="top" title="" data-original-title="DÜZENLE"><i class="fa fa-pencil fa-lg"></i> Düzenle</a>
							</strong>
						</div>
					</div>


					<div style="text-align:center;padding-bottom:20px;">
						<img src="@Model.Fotograf"
							 style="border-radius: 50%;    width: 104px;height: 97px;border: 6px solid #ececec;" />
					</div>

					<div style="text-align:center;padding-bottom:20px;">
						<div class="form-group">


							@{ var degerlendirme_puani = Model.puan;


								int w = 1;
								var k = 0;

								while (w < 6)
								{
									if (k == 0)
									{

										for (int i = 0; i < degerlendirme_puani; i++)
										{
											<span class="fa fa-star checked" style="color:#ffbf00; font-size:large;"></span>

											w++;
											k++;
										}
									}

									if (w == 6)

									{ break; }

									<span class="fa fa-star"></span>

									w++;
								}

							}

								&nbsp;	<strong>(@Math.Round(Model.puan, 1))</strong>

							<br />

							<strong>@Html.DisplayFor(m => m.UserName, new { @class = "form-control" })</strong>
						</div>
					</div>

					<div class="form-group">
						<div class="col-md-6 padding-left-0">
							@Html.LabelFor(m => m.EmailAdresi, new { @class = "col-md-12 control-label" })
						</div>
						<div class="col-md-6 text-right">
							<strong>	@Html.DisplayFor(m => m.EmailAdresi, new { @class = "col-md-12 control-label" })</strong>
</div>
					</div>


					<div class="form-group">
						<div class="col-md-8 padding-left-0">
