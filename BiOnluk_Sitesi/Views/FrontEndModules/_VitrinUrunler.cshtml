@model IEnumerable<HemenTanitim.Models.UrunListele2>






<div class="px-3 pt-3 title d-flex align-items-center">
    <h6 class="m-0 font-weight-bold">Trending this week</h6>
    <a class="font-weight-bold ml-auto" href="/UrunListesi/Trending">View all <i class="feather-chevrons-right"></i></a>
</div>
<!-- slider -->

@{
    int MostPopularSayi = 1;
    int MostPopularSayiIc = 1;
    int mostSalesSayi = 0;

}



<div class='trending-slider'>
    @foreach (var items in Model.Where(x => x.Vitrin == true))
    {
        <div class="osahan-slider-item py-3 px-1">
            <div class="list-card bg-white h-100 rounded overflow-hidden position-relative shadow-sm">
                <div class="list-card-image">
                    @*<div class="star position-absolute">
                            <span class="badge badge-success">
                                <i class="feather-star"></i>
                                @item.puan_ortalamasi
                            </span>
                        </div>*@
                    <div class="favourite-heart position-absolute"><a href="#"><i class="feather-bookmark"></i></a></div>
                    @if (items.Hot)
                    {
                        <div class="member-plan position-absolute"><span class="badge badge-danger">HOT</span></div>
                    }
                    else if (items.Promoted)
                    {
                        <div class="member-plan position-absolute"><span class="badge badge-warning">Promoted</span></div>
                    }
                    else if (items.Trending)
                    {
                        <div class="member-plan position-absolute"><span class="badge badge-info">Trending</span></div>
                    }

                    <a href="@Url.Action("Index", "UrunDetay", new { urunAdi = items.baslik.ToSeoUrl().Trim(), isId = items.isId })">
                        <img src="@items.ResimYolu" class="img-fluid items-img w-100">
                    </a>

                </div>
                <div class="p-3 position-relative">
                    <div class="list-card-body">
                        <h6 class="mb-1">
                            <a href="@Url.Action("Index", "UrunDetay", new { urunAdi = items.baslik.ToSeoUrl().Trim(), isId = items.isId })"
                               class="text-black">
                                @items.baslik.FirstCharToUpper().TrimFrontIfLongerThan(50)
                            </a>
                        </h6>
                        <p class="text-gray mb-3">@items.AnaKategoriAdi, @items.AltKategoriAdi</p>

                        <p class="text-gray mb-3 time">
                            <span class="bg-light text-dark rounded-sm pl-2 pb-1 pt-1 pr-2">
                                <i class="feather-clock"></i> @items.TeslimSuresi
                            </span>
                            <span class="float-right text-black-50">
                                <strong>@items.MinFiyat TL</strong> For @items.kacKisilik
                            </span>
                        </p>

                    </div>
                    @if (items.indirimOrani > 0)
                    {
                        <div class="list-card-badge d-flex align-itemss-center">
                            <span class="badge badge-success mr-2">OFFER</span> <small>@items.indirimOrani % off</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<div class="offer-slider bg-white border-top border-bottom">
    <div class="cat-item px-1 py-3">
        <a class="d-block text-center" href="/UrunListesi/Trending">
            <img src="~/Content/UI/img/pro1.jpg" class="img-fluid rounded rounded-lg shadow-sm">
        </a>
    </div>
   
    <div class="cat-item px-1 py-3">
        <a class="d-block text-center" href="/UrunListesi/Trending">
            <img src="~/Content/UI/img/pro3.jpg" class="img-fluid rounded rounded-lg shadow-sm">
        </a>
    </div>
    <div class="cat-item px-1 py-3">
        <a class="d-block text-center" href="/UrunListesi/Trending">
            <img src="~/Content/UI/img/pro4.jpg" class="img-fluid rounded rounded-lg shadow-sm">
        </a>
    </div>
</div>

<!-- Most popular -->
<div class="px-3 pt-4 pb-3 title d-flex align-items-center">
    <h6 class="m-0 font-weight-bold">Most popular</h6>
    <a class="font-weight-bold ml-auto" href="#">
        <i class="feather-more-vertical"></i>
        @Model.Where(x => x.mostPopular == true).Count() products


    </a>
</div>
<div class="most_popular px-3">



    @foreach (var items in Model.Where(x => x.mostPopular == true).Take(4))
    {
        if (MostPopularSayi == 3)
        {
            @Html.Raw("<div class='row pt-2'>")
        }

        if (MostPopularSayi == 1 && MostPopularSayiIc == 1)
        {
            @Html.Raw("<div class='row'>")
        }

                  <div class="col-6 pr-1">
            <div class="list-card bg-white h-100 rounded overflow-hidden position-relative shadow-sm">
                <div class="list-card-image">
                    <div class="star position-absolute"><span class="badge badge-success"><i class="feather-star"></i> 4+</span></div>
                    <div class="favourite-heart position-absolute"><a href="#"><i class="feather-bookmark"></i></a></div>

                    <div class="member-plan position-absolute"><span class="badge badge-danger">HOT</span></div>


                    @if (items.Hot)
                    {
                        <div class="member-plan position-absolute"><span class="badge badge-danger">HOT</span></div>
                    }
                    else if (items.Promoted)
                    {
                        <div class="member-plan position-absolute"><span class="badge badge-dark">Promoted</span></div>
                    }
                    else if (items.Trending)
                    {
                        <div class="member-plan position-absolute"><span class="badge badge-info">Trending</span></div>
                    }
                    <a href="@Url.Action("Index", "UrunDetay", new { urunAdi = items.baslik.ToSeoUrl().Trim(), isId = items.isId })">
                        <img src="@items.ResimYolu" class="img-fluid items-img w-100">
                    </a>

                </div>
                <div class="p-3 position-relative">
                    <div class="list-card-body">
                        <h6 class="mb-1">
                            <a href="@Url.Action("Index", "UrunDetay", new { urunAdi = items.baslik.ToSeoUrl().Trim(), isId = items.isId })"
                               class="text-black">
                                @items.baslik
                            </a>
                        </h6>
                        <p class="text-gray mb-1 small">@items.AnaKategoriAdi, @items.AltKategoriAdi</p>
                        <p class="text-gray mb-1 rating">
                            <span class="text-black-50">
                                <strong>@items.MinFiyat TL</strong> For @items.kacKisilik
                            </span>
                        </p>
                    </div>
                    @if (items.indirimOrani > 0)
                    {
                        <div class="list-card-badge d-flex align-items-center">
                            <span class="badge badge-danger mr-2">OFFER</span> <small>@items.indirimOrani% off</small>

                        </div>
                    }
                    </div>
            </div>
        </div>


        if (MostPopularSayiIc == 2 || MostPopularSayiIc == 4)
        {
            @Html.Raw("</div>")
        }


        MostPopularSayiIc++;
        MostPopularSayi++;
    }
</div>

<div class="p-3">
    <a href="/UrunListesi/Trending">
        <img src="~/Content/UI/img/banner.png" class="img-fluid rounded-lg">
    </a>
</div>
<!-- Most
    sales -->
<div class="px-3 pt-4 pb-3 title d-flex align-items-center">
    <h6 class="m-0 font-weight-bold">Most sales</h6>
    <a class="font-weight-bold ml-auto" href="#">
        <i class="feather-more-vertical"></i>
        @Model.Where(x => x.mostSales == true).Count() products

    </a>
</div>
<!-- Most sales -->
<div class="most_sale px-3 pb-5">
    <div class="row">
        <!-- Most popular -->
        @{string ekle = "col-12"; }
        @foreach (var items in Model.Where(x => x.mostSales == true).Take(4))
        {
            if (mostSalesSayi > 0)
            {
                ekle = "col-12 pt-2";
            }

            <div class="@ekle">
                <div class="d-flex align-items-center list-card bg-white h-100 rounded overflow-hidden position-relative
                     shadow-sm homepage-osahan-list-items">
                    <div class="list-card-image">

                        <div class="favourite-heart position-absolute"><a href="#"><i class="feather-bookmark"></i></a></div>

                        @if (items.Hot)
                        {
                            <div class="member-plan position-absolute"><span class="badge badge-danger">HOT</span></div>
                        }
                        else if (items.Promoted)
                        {
                            <div class="member-plan position-absolute"><span class="badge badge-dark">Promoted</span></div>
                        }
                        else if (items.Trending)
                        {
                            <div class="member-plan position-absolute"><span class="badge badge-info">Trending</span></div>
                        }


                        <a href="@Url.Action("Index", "UrunDetay", new { urunAdi = items.baslik.ToSeoUrl().Trim(), isId = items.isId })">
                            <img src="@items.ResimYolu" class="img-fluid item-img w-100">
                        </a>
                    </div>
                    <div class="p-3 position-relative">
                        <div class="list-card-body">
                            <h6 class="mb-1">
                                <a href="@Url.Action("Index", "UrunDetay", new { urunAdi = items.baslik.ToSeoUrl().Trim(), isId = items.isId })"
                                   class="text-black">
                                    @items.baslik
                                </a>
                            </h6>
                            <p class="text-gray mb-3">@items.AnaKategoriAdi, @items.AltKategoriAdi</p>
                            <p class="text-gray mb-3 time">
                                <span class="bg-light text-dark rounded-sm pb-1 pt-1 pr-2">
                                    <strong>@items.MinFiyat TL</strong> For @items.kacKisilik
                                </span>

                            </p>
                        </div>
                        @if (items.indirimOrani > 0)
                        {
                            <div class="list-card-badge d-flex align-items-center">
                                <span class="badge badge-danger mr-2">OFFER</span> <small>@items.indirimOrani% off</small>
                            </div>
                        }
                        </div>
                </div>
            </div>


            mostSalesSayi++;
        }
    </div>
</div>