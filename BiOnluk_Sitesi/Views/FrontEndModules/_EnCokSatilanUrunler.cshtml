@model IEnumerable<HemenTanitim.Models.VitrinUrunleri>

<section class="section seller-product wow fadeInUp">
    <h3 class="section-title">En çok satanlar</h3>
    <div class="row outer-top-xs center">

        @foreach (var item in Model)
        {
            <div class="col-md-4 col-sm-6">
                <div class="products">

                    <div class="product">
                        <div class="product-micro">
                            <div class="row product-micro-row">
                                <div class="col col-xs-6">
                                    <div class="product-image">
                                        <div class="image">
                                            <a href="@Url.Action("Index", "UrunDetay", new { urunAdi = item.UrunAdi.ToSeoUrl().Trim(), id = item.Id })" title="@item.UrunAdi">
                                                <img src="@item.ThumbYolu" alt="@item.tag" height="170" width="169" />

                                            </a>
                                        </div><!-- /.image -->
                                        @if (item.IndirimOrani != null)
                                        {
                                              <div class="tag tag-micro hot">
                                                    <span style="font-size:14px">%@item.IndirimOrani</span>
                                                </div>
                                        }
                                        else
                                        {
                                               <div class="tag tag-micro sale">
                                                    <span style="font-size:18px">✯</span>
                                                </div>
                                        }
                                     
                                    </div><!-- /.product-image -->
                                </div><!-- /.col -->
                                <div class="col col-xs-6">
                                    <div class="product-info">
                                        <h3 class="name"><a href="@Url.Action("Index", "UrunDetay", new { urunAdi = item.UrunAdi.ToSeoUrl().Trim(), id = item.Id })" title="@item.UrunAdi" class="pricetext"> @item.UrunAdi.TrimFrontIfLongerThan(20)</a></h3>
                                        <div class="rating rateit-small"></div>
                                        <div class="product-price" style="padding-top: 10px;">
                                            <span class="price" style="font-size:16px">
                                                <span class="price-before-discount" style="font-size:16px">
                                                @String.Format("{0:N}", item.UstuCiziliFiyat) <i class="fa fa-turkish-lira"></i></span>
                                                <br />
                                               @String.Format("{0:N}", item.Fiyat) <i class="fa fa-turkish-lira"></i>
                                            </span>
                                           
                                        </div><!-- /.product-price -->

                                        <div class="cart-button button-group" style=" padding: 10px 0px 10px; ">
                                            <a href="@Url.Action("Index", "UrunDetay", new { urunAdi = item.UrunAdi.ToSeoUrl().Trim(), id = item.Id })" title="cafe-sandalyesi-ucs-03" class="btn btn-cart">
                                                <i class=" fa fa-shopping-cart">
                                                </i>
                                                Ürün detay
                                            </a>
                                        </div>
                                    </div>
                                </div><!-- /.col -->
                            </div><!-- /.product-micro-row -->
                        </div><!-- /.product-micro -->
                    </div>

                </div>
            </div>
        }




    </div>

</section>
