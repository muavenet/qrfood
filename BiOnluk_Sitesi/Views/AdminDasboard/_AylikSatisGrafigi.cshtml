<div class="box box-primary">
    <div class="box-header">
        <i class="fa fa-area-chart"></i>
        <h3 class="box-title">AYLIK SATIŞ GRAFİĞİ</h3>
        <small class="pull-right">Satış tablosunda ki rakamlar TL para cinsindendir&nbsp;&nbsp; &nbsp;  </small>
    </div>
    <div class="box-body chart-responsive">
        <div class="chart" id="revenue-chart_" style="height:200px"></div>
    </div><!-- /.box-body -->
</div><!-- /.box -->



<script type="text/javascript">
    $(function () {

        var result = [];

        $.ajax({

            url: "@Url.Action("AylikSatisGrafigi")",

            type: "GET",

            data: {},

            success: function (data) {

                $.each(data, function (id, book) {
                    result.push({ "month": book.AylikSatis, "value": book.ToplamSatis });
                });
               
                var area = new Morris.Area({
                    element: 'revenue-chart_',
                    resize: true,
                    data:  result,
                    xkey: 'month',
                    ykeys: ['value'],
                    labels: ['GELİR'],
                    lineColors: ['#a0d0e0', '#3c8dbc'],
                    hideHover: 'auto'
                });

            }
        });
    });
</script>