@model IEnumerable<HemenTanitim.Models.UstMenuModel>

@foreach (var item in Model)
{ 
<div class="col-lg-3 col-xs-6">
    <!-- small box -->
    <div class="small-box bg-aqua">
        <div class="inner">
            <h3>
                @item.YeniSiparis
            </h3>
            <p>
                Yeni sipariş
            </p>
        </div>
        <div class="icon">
            <i class="ion ion-bag"></i>
        </div>
        <a href="#" class="small-box-footer">
            @*<a href="@Url.Action("Index","AdminSiparisIslemleri")" class="small-box-footer">*@
                Siparişlere git <i class="fa fa-arrow-circle-right"></i>
            </a>
    </div>
</div><!-- ./col -->
<div class="col-lg-3 col-xs-6">
    <!-- small box -->
    <div class="small-box bg-green">
        <div class="inner">
            <h3>
                @item.OnaysizYorum
            </h3>
            <p>
                Onay bekleyen ürün yorumları
            </p>
        </div>
        <div class="icon">
            <i class="ion ion-stats-bars"></i>
        </div>
        <a href="#" class="small-box-footer">
            @*<a href="@Url.Action("Index","Yorumlars")" class="small-box-footer">*@
            Yorumlara git <i class="fa fa-arrow-circle-right"></i>
        </a>
    </div>
</div><!-- ./col -->
<div class="col-lg-3 col-xs-6">
    <!-- small box -->
    <div class="small-box bg-yellow">
        <div class="inner">
            <h3>
                @item.KayitliKullanici
            </h3>
            <p>
                Kayıtlı kullanıcı
            </p>
        </div>
        <div class="icon">
            <i class="ion ion-person-add"></i>
        </div>
        <a href="#" class="small-box-footer">
            @*<a href="@Url.Action("UserList","Role")" class="small-box-footer">*@
            Kullanıcı listesi <i class="fa fa-arrow-circle-right"></i>
        </a>
    </div>
</div><!-- ./col -->
<div class="col-lg-3 col-xs-6">
    <!-- small box -->
    <div class="small-box bg-red">
        <div class="inner">
            <h3>
                @item.OkunmayanMesajlar
            </h3>
            <p>
                Cevaplanmayan mesajlar
            </p>
        </div>
        <div class="icon">
            <i class="ion ion-pie-graph"></i>
        </div>
        <a href="#" class="small-box-footer">
            @*<a href="@Url.Action("Index","Mesajlars")" class="small-box-footer">*@
            Mesajlara git <i class="fa fa-arrow-circle-right"></i>
        </a>
    </div>
</div><!-- ./col -->
}