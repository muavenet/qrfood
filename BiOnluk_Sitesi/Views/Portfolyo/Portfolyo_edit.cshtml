@model HemenTanitim.Models.Portfolyo_m

@{
	ViewBag.Title = "Edit";
	Layout = "~/Views/Shared/_LayoutMusteriPaneli.cshtml";
}

@using (Html.BeginForm("Edit", "Portfolyo", FormMethod.Post, new { @class = "form-horizontal", role = "form", enctype = "multipart/form-data" }))
{

		@Html.AntiForgeryToken()

		@Html.Hidden("urunIds", (int)ViewBag.Id)
		@Html.HiddenFor(m => m.port_Id)
		@Html.HiddenFor(m => m.userId)

	<div class="adpost-details">
			<div class="col-md-6">
				<!-- /.modal -->

				<fieldset>
					<div class="section postdetails" style="background-color: white;">
						<h4>
							Portfolyo Ekle <span class="pull-right">
	<a href="/Portfolyo/Portfolyo_m/" class="btn btn-large">
		<i class="fa fa-plus-circle"></i>	Yeni Portfolyo



	</a>
</span>
						</h4>

						<div class="row form-group add-image">
							<label class="col-sm-4 label-title">Portfolyo Fotoğrafı <span>(Optimum ölçüler 700 X 500 )</span> </label>
							<div class="col-sm-8">
								<h5><i class="fa fa-upload" aria-hidden="true"></i>Bir fotoğraf seçiniz </h5>

								<label class="btn-bs-file btn btn-default">
									<i class="fa fa fa-plus-circle  text-success"></i> Fotoğrafı Ekle
									@Html.HiddenFor(m => m.Fotograflar, new { name = "fotograflar" })
									@Html.TextBoxFor(model => model.PostedFile, new { type = "file" })
								</label>

							</div>
						</div>


						<div class="row form-group add-title">
							<label class="col-sm-4 label-title">Başlık<span class="required">*</span></label>
							<div class="col-sm-8">
								@Html.TextBoxFor(model => model.baslik, new { @class = "form-control smallElements" })
								@Html.ValidationMessageFor(model => model.baslik)
							</div>
						</div>

						<div class="row form-group add-title">
							<label class="col-sm-4 label-title">Url</label>
							<div class="col-sm-8">
								@Html.TextBoxFor(model => model.demoUrl, new { @class = "form-control smallElements", placeholder = "Örn: http://orneksite.com" })
								@Html.ValidationMessageFor(model => model.demoUrl)
							</div>
						</div>

						<div class="row form-group add-title">
							<label class="col-sm-4 label-title">Kategori<span class="required">*</span></label>
							<div class="col-sm-6">
								@Html.DropDownList("AnaKategoriId", (IEnumerable<SelectListItem>)ViewBag.KategoriId, "Seçiniz",
							   new { @class = "form-control smallElements", @onchange = "AltKategorileriGetir()" })
							</div>
						</div>

						<div class="row form-group add-title">
							<label class="col-sm-4 label-title">Site Kategorisi<span class="required">*</span></label>
							<div class="col-sm-6">
								@Html.DropDownList("AltKategoriId1", (SelectList)ViewBag.AltKategoriId_, new { @class = "form-control smallElements" })

							</div>
						</div>



						<div class="checkbox section agreement">
							<button type="submit" class="btn btn-primary">Kaydet</button>
						</div><!-- section -->

					</div>
				</fieldset>
			</div>

			<div class="section quick-rules" style="background-color: white;">
				<h4>Portfolyo</h4>

				@{ Html.RenderAction("Portfolyo_m_Liste", "Portfolyo"); }

			</div>
			
	</div>

}


@*<script src="/Scripts/jquery-1.10.2.js"></script>*@
<script src="/Scripts/jquery.validate.js"></script>
<script src="/Scripts/jquery.validate.unobtrusive.js"></script>

<script>
	function AltKategorileriGetir() {

		var AnaKatId_ = $("#AnaKategoriId").val();

		var element = $("#AltKategoriId");


		$.ajax({
			url: '/Filtre/HizliAramaaltKategorileriGetir',
			type: "GET",
			dataType: "JSON",
			data: { anaKatId: AnaKatId_ },
			success: function (cities) {

				element.html("");

				element.append($('<option></option>').val(0).html("Seçiniz"));

				$.each(cities, function (i, city) {

					element.append(
						$('<option></option>').val(city.Id).html(city.KategoriAdi));

				});
			}
		});
	}
</script>