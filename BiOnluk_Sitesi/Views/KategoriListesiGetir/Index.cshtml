@model IEnumerable<HemenTanitim.Models.AnaKategoriler>

<ul class="dropdown-menu category-change pull-right" id="filtre_dropdown">
    @foreach (var item in Model)
    {
        <li>
            <a href="@item.link" title="@item.KategoriAdi">@item.KategoriAdi</a>
        </li>

    }
</ul>



