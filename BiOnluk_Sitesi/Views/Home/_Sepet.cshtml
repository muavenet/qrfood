

    <a href="/Sepet"  title="Sepet"><i class="fa fa-shopping-cart"></i> <span id="messagesTable"></span></a>



    <script src="/Scripts/jquery-2.2.1.min.js"></script>
    <script src="/Scripts/jquery-ui-1.8.20.min.js"></script>
    <script src="/Scripts/jquery.signalR-2.2.0.js"></script>
    <!--Reference the autogenerated SignalR hub script. -->
    <script src="/signalr/hubs"></script>

    <script type="text/javascript">

        var $Conf = jQuery.noConflict();

        $Conf(function () {

            // Declare a proxy to reference the hub.
            var notifications = $Conf.connection.sepetHub;

            //debugger;
            // Create a function that the hub can call to broadcast messages.
            notifications.client.displayStatus = function () {
                getAllMessages()

            };
            // Start the connection.
            $Conf.connection.hub.start().done(function () {
                //alert("connection started")
                getAllMessages();
            }).fail(function (e) {
                alert(e);
            });
        });


        function getAllMessages() {

            var tbl = $Conf('#messagesTable');

            $Conf.ajax({
                url: '/home/GetMessages',
                contentType: 'application/html ; charset:utf-8',
                type: 'GET',
                dataType: 'html'
            }).success(function (result) {
                tbl.empty().append(result);
            }).error(function () {

            });
        }
    </script>
