<style>
    #fixBottomClientSupport
    {
        position: fixed;
        bottom:0;
        right : 15px;
        
    }
</style>

<script src="~/Scripts/knockout-3.3.0.js"></script>
<script src="~/Scripts/jquery-2.1.3.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>



<div id="fixBottomClientSupport" class="col-lg-2">



    <div class="panel list-group" style="margin-bottom:0">
        <a href="#" class="list-group-item collapse" data-toggle="collapse" data-target="#sm" data-parent="#menu" style="background-color:red; color:white; font-size:medium;">
        <i class="icon fa fa-headphones"></i>&nbsp;CANLI DESTEK <i class="fa fa-minus pull-right"></i></a>
        <div id="sm" class="sublinks collapse">

            <div class="box box-success">
                <div class="box-body chat" id="chat-box" style="height: 355px !important; overflow-y: scroll; background-color:rgba(128, 128, 128, 0.06)/*">
                              
                    <div id="messages" class="item" data-bind="foreach: messages">
                                              
                        <p class="message" style="padding-left: 15px;" >
                            <br />
                            <strong><span data-bind="text: from"></span>: </strong>

                            <span data-bind="text: message"></span>
                        </p>
                    </div>                   
                </div>

                <div class="box-footer">
                    <div class="input-group">
                        <input class="form-control" placeholder="Mesajınızı giriniz..." id="txtMsg" />
                        <div class="input-group-btn">
                            <button class="btn btn-success" id="btnSend"><i class="fa fa-plus"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    
    </div>
</div>

<script src="~/Scripts/jquery.signalR-2.2.0.min.js"></script>
<script src="~/signalr/hubs"></script>
<script src="~/js/chat.js"></script>