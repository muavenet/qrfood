<body class="wysihtml5-supported fixed pace-done skin-black">
    <!-- header logo: style can be found in header.less -->
    <header class="header">
        <a href="@Url.Action("Index", "HotelDasboard")" class="logo">
            <!-- Add the class icon to your logo image or logo icon to add the margining -->
            Turistik Yemek Sepeti
        </a>
        <!-- Header Navbar: style can be found in header.less -->
        <nav class="navbar navbar-static-top" role="navigation">
            <!-- Sidebar toggle button-->
            <a href="#" class="navbar-btn sidebar-toggle" data-toggle="offcanvas" role="button">
                <span class="sr-only">Toggle navigation</span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </a>
            <div class="navbar-right">
                <ul class="nav navbar-nav">
                    <!-- User Account: style can be found in dropdown.less -->
                    <li class="dropdown user user-menu">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                            <i class="glyphicon glyphicon-user"></i>
                            <span>@User.Identity.Name <i class="caret"></i></span>
                        </a>
                        <ul class="dropdown-menu">
                            <!-- User image -->
                            <li class="user-header bg-light-blue">
                                <img src="@Url.Content("~/Content/Admin/img/Avatar.jpg")" class="img-circle" alt="User Image" />
                                <p>
                                    @User.Identity.Name
                                    <small>Admin olarak giriş yaptınız</small>
                                </p>
                            </li>
                            <!-- Menu Body -->
                            <!-- Menu Footer-->
                            <li class="user-footer">
                                <div class="pull-left">

                                    <a href="@Url.Action("Manage", "Account")" class="btn btn-default btn-flat">Şifre değiştir</a>
                                </div>
                                <div class="pull-right">
                                    @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <a href="javascript:document.getElementById('logoutForm').submit()" class="btn btn-default btn-flat">
                                            Çıkış
                                        </a>
                                    }
                                </div>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="wrapper row-offcanvas row-offcanvas-left ">
        <!-- Left side column. contains the logo and sidebar -->
        <aside class="left-side sidebar-offcanvas">
            <!-- sidebar: style can be found in sidebar.less -->
            <section class="sidebar">
                <!-- Sidebar user panel -->
                <div class="user-panel">
                    <div class="pull-left image">
                        <img src="@Url.Content("~/Content/Admin/img/Avatar.jpg")" class="img-circle" alt="User Image" /><br />
                    </div>
                    <div class="pull-left info">
                        <p>Yönetim Paneli @*@User.Identity.Name*@</p>
                        <a href="#"><i class="fa fa-circle text-success"></i> Online</a>
                    </div>
                </div>
                <!-- search form -->
            
                <!-- /.search form -->
                <!-- sidebar menu: : style can be found in sidebar.less -->
                <ul class="sidebar-menu">

                    <li id="dashboard" >
                        <a href="@Url.Action("Index", "HotelDasboard")">
                            <i class="fa fa-dashboard"></i>
                            Ana Ekran<span></span>
                        </a>
                    </li>

                    <li id="Siparisler">                      
                        <a href="@Url.Action("Siparisler", "HotelDasboard")">
                            <i class="fa fa-clock-o"></i> <span>Siparişler</span>
                        </a>
                    </li>

                    <li id="mailbox">
                        @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm",
                            style = "padding-left: 15px;padding-top: 12px;padding-bottom: 12px;" }))
                        {
                            @Html.AntiForgeryToken()

                            <a href="javascript:document.getElementById('logoutForm').submit()">
                                <i class="fa  fa-sign-out"></i> <span> Çıkış yap</span>
                            </a>
                        }
                    </li>
                </ul>
            </section>
            <!-- /.sidebar -->
        </aside>

        @RenderBody()

    </div><!-- ./wrapper -->

    @RenderSection("scriptFooter", required: false)    
</body>
</html>
