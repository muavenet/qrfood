<!DOCTYPE html>
<html>
<head>

	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta http-equiv="Content-Language" content="tr" />
	<meta name="robots" content="NOINDEX, NOFOLLOW" />

	@RenderSection("metaTags", required: false)

	@RenderSection("header", required: false)

	@Styles.Render("~/Content/css")


	@*@Scripts.Render("/bundles/modernizr")*@

	<link href='https://fonts.googleapis.com/css?family=Ubuntu:400,500,700,300' rel='stylesheet' type='text/css'>
	<link href='https://fonts.googleapis.com/css?family=Signika+Negative:400,300,600,700' rel='stylesheet' type='text/css'>


	<!-- icons -->
	<script src="https://kendo.cdn.telerik.com/2017.1.223/js/jquery.min.js"></script>
	<script src="https://kendo.cdn.telerik.com/2017.1.223/js/kendo.all.min.js"></script>


</head>
<body>

    @if (!Request.Browser.IsMobileDevice)
    {
        <header id="header" class="clearfix">
            <!-- navbar -->
            <nav class="navbar navbar-default   box-shadow-genel">
                <div class="container" style="width:1445px">
                    <!-- navbar-header -->
                    <div class="navbar-header">

                        <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbar-collapse">
                            <span class="sr-only">Toggle navigation</span>
                            <span class="icon-bar"></span>
                            <span class="icon-bar"></span>
                            <span class="icon-bar"></span>
                        </button>

                        <a class="navbar-brand" href="/" style="padding-top:0 !important;  margin-left: 10px !important;">
                            <img class="img-responsive" src="/Content/FrontEnd/images/logo.jpg" alt="Logo" style="height:60px">
                        </a>

                    </div>
                    <!-- /navbar-header -->

                    <div class="navbar-right">

                        <div class="collapse navbar-collapse" id="navbar-collapse">

                            <ul class="nav navbar-nav" style="width:100%">

                                @{Html.RenderAction("Index", "KategoriListesiGetir");}

                                @*<li>
                                        <a href="/">SEKTÖREL YAZILAR</a>
                                    </li>*@


                            </ul>
                        </div>
                    </div>


                    <!-- nav-right -->
                </div><!-- container -->
            </nav><!-- navbar -->
        </header><!-- header -->

        @RenderBody()

        { Html.RenderAction("_Footer", "FrontEndModules"); }
    }

    else
    {
        <header id="header" class="clearfix">
            <!-- navbar -->
            <nav class="navbar navbar-default   box-shadow-genel">
                <div class="container" style="width:1445px">
                    <!-- navbar-header -->
                    <div class="navbar-header">
                        <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbar-collapse">
                            <span class="sr-only">Toggle navigation</span>
                            <span class="icon-bar"></span>
                            <span class="icon-bar"></span>
                            <span class="icon-bar"></span>
                        </button>
                        <a class="navbar-brand" href="/" style="padding-top:0 !important;  margin-left: 10px !important;">
                            <img class="img-responsive" src="/Content/FrontEnd/images/logo.jpg" alt="Logo" style="height:60px">
                        </a>
                    </div>
                </div><!-- container -->
            </nav><!-- navbar -->
        </header><!-- header -->

        @RenderBody()

        <style>
            .icon-bar_ {
                width: 100%; /* Full-width */
                background-color: #555; /* Dark-grey background */
                overflow: auto; /* Overflow due to float */
                position: fixed;
                left: 0;
                bottom: 0;
                width: 100%;
            }

                .icon-bar_ a {
                    float: left; /* Float links side by side */
                    text-align: center; /* Center-align text */
                    width: 25%; /* Equal width (5 icons with 20% width each = 100%) */
                    padding: 12px 0; /* Some top and bottom padding */
                    transition: all 0.3s ease; /* Add transition for hover effects */
                    color: white; /* White text color */
                    font-size: 14px; /* Increased font size */
                }

                    .icon-bar_ a:hover {
                        background-color: #000; /* Add a hover color */
                    }

                .icon-bar_ .active {
                    background-color: #4CAF50; /* Add an active/current color */
                }
        </style>

        <div class="icon-bar_">
            <a class="@(ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")" href="/"><i class="fa fa-home"></i><br />Anasayfa</a>
            <a class="@(ViewContext.RouteData.Values["Action"].ToString() == "AnaKategoriler" ? "active" : "")" href="/Mobile/AnaKategoriler"><i class="fa fa-list-alt"></i><br />Hizmetler</a>
            <a class="@(ViewContext.RouteData.Values["Action"].ToString() == "Arama" ? "active" : "")" href="/Mobile/Arama"><i class="fa fa-search"></i><br />Arama</a>
            <a class="@(ViewContext.RouteData.Values["Action"].ToString() == "Panel" ? "active" : "")" href="/Mobile/Panel"><i class="fa fa-dashboard"></i><br />Panel</a>
        </div>

    }


    @*@Scripts.Render("/bundles/jquery")*@

    @*@Scripts.Render("~/bundles/bootstrap")*@

    @RenderSection("scripts", required: false)



    <script>

        var $LogOff = jQuery.noConflict();

        $LogOff(document).ready(function () {

            $LogOff.ajaxSetup({
                cache: false
            });

            $LogOff(document).ajaxError(
                function (e, request) {
                    if (request.status == 401) {
                        //alert("Your session has expired. Please login again to continue.");
                        window.location = "/Account/LogOff";
                    } else {

                    }
                }
            );
        });
    </script>

    <script type="text/javascript">
        function googleTranslateElementInit() {
            new google.translate.TranslateElement({ pageLanguage: 'en', includedLanguages: 'tr,es,fr,de,ko,pl,ru,zh-CN,ar', layout: google.translate.TranslateElement.InlineLayout.SIMPLE }, 'google_translate_element');
        }
    </script>
    <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

</body>
</html>
