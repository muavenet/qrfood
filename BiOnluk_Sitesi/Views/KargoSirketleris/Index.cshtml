@model IEnumerable<HemenTanitim.Models.KargoSirketleri>

@using Resources;


@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/Admin.cshtml";

}

<style>
    .text-center {
        text-align: left;
    }
</style>


<aside class="right-side">

    <section class="content-header">
        <h1>
            Kargo firmalar&#305;
        </h1>
        <ol class="breadcrumb">
            <li><a href="#"><i class="fa fa-dashboard"></i> Anasayfa</a></li>
            <li class="active">Kargo firmalar&#305; listesi</li>
         
        </ol>
    </section>

    <section class="content">
        <div class='row'>
            <div class='col-xs-12'>
                <div class='box box-info'>

                    <div class='box-header'>
                        <h3 class='box-title'>@Html.ActionLink("Yeni olustur", "Create")</h3>
                    </div>

                   
              


            <div class="box-body table-responsive" style="overflow:hidden">
                <table id="tblListe" class="table table-bordered table-striped">

                    <thead>
                        <tr>
                           
                            <th>
                                @Html.DisplayNameFor(model => model.kargoSirketAdi)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.fiyat) 
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.sonGuncelleme)
                            </th>
                            <th></th>

                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                              
                                <td>
                                    @item.kargoSirketAdi
                                </td>
                                <td style="text-align:right">
                                    @String.Format("{0:F}", item.fiyat) <i class="fa fa-turkish-lira"></i>
                                </td>
                                <td>
                                    @String.Format("{0:g}", item.sonGuncelleme.ToShortDateString())
                                </td>
                                <td>
                                    @Html.ActionLink("Duzenle", "Edit", new { aid = item.Id }) |
                                    @Html.ActionLink("Sil", "Delete", new { aid = item.Id })
                                </td>
                            </tr>
                        }
                    <tbody>
                </table>
            </div>
</div>
        </div>

                  </section></aside>

 @section scriptFooter{

    @Scripts.Render("~/bundles/datatables")

  <script src="~/Scripts/plugins/datatables/dataTablesConfigurations.js"></script>

<script>

    $(document).ready(function () {

        $("li").removeClass("active");
        $("#kargo").addClass("active");
        $("#kargo_menu").css("display", "block");
        $("#kargo_simple").addClass("active");
        $("#kargo_arrow").addClass("fa-angle-down");

        $("#wysihtml5").wysihtml5();

    });
</script>
}