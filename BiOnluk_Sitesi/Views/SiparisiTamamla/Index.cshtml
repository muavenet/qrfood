@model HemenTanitim.Models.SiparisBilgileri

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_SiparisSayfasi.cshtml";
}

@section header{


    @*<link href="~/Content/tabs/prettify.css" rel="stylesheet" />*@

    <style>
        .nav-pills > li.active > a, .nav-pills > li.active > a:focus, .nav-pills > li.active > a:hover {
            background-color:transparent !important; 
        }
        .select-category > li > a {
            display: inline !important;
        }

    </style>

}
	<section id="main" class="clearfix details-page">


		@if (!Request.Browser.IsMobileDevice)
		{
			<div class="col-md-12 col-sm-4" style="border-bottom:2px solid #f3f3f3; margin-bottom:6px; margin-top:20px;">
				<div class="container">
					<div class="col-md-3 col-sm-4">


					</div>
					<div class="col-md-5 col-sm-4">

						@{Html.RenderAction("_BasitArama", "Filtre");}

					</div>
					<div class="col-md-4 col-sm-4 text-center">
						@Html.Partial("_LoginPartial")
					</div>
				</div>
			</div>
		}


		<div class="container">
			<div class="adpost-details">
				<div class="row">
					<div class="col-md-8">

						<fieldset>
							<div class="section postdetails">
								@* <h4>Sell an item or service <span class="pull-right">* Mandatory Fields</span></h4>*@
								<div class="form-group selected-product" id="rootwizard">

									<ul class="select-category list-inline">
										<li><a href="/Sepet">Sepet</a></li>
										<li class="active"><a href="#tab1" data-toggle="tab">Sipariş Bilgileri</a></li>
										<li><a href="#tab2" data-toggle="tab">Ödemeyi Tamamla</a></li>
									</ul>

									<div class="tab-content">
										<div class="tab-pane fade active in" id="tab1">
											<div class="row form-group add-image">
												<div class="col-sm-12">

													<br /><br />

													<div class="upload-section">

														<form id="formIcerik" action="" method="post">

															<div class="row form-group add-image">
																<div class="col-sm-12">
																	<h3>

																		Satın almakta olduğunuz ilanın bilgileri
																		@*<span>Maks. dosya boyutu 1 mb'ı geçmemelidir.</span>*@
																	</h3>

																</div>
															</div>



															<div class="checkbox section agreement">
																<input type="checkbox" name="chckKabulEt" id="chckKabulEt" checked>
																<span id="uySpan">Ödeme şartlarını kabul ediyorum.</span>
															</div>

															<ul class="pager wizard">
																<li class="previous"><a href="#">Sepete Geri Dön</a></li>
																<li class="next">
																<li class="next" id="btnDevam_Siparis">
																	<a href="#">
																		Devam et&nbsp;&nbsp;
																		<span class="glyphicon glyphicon-arrow-right"></span>
																	</a>
																</li>
															</ul>

														</form>


													</div>
												</div>

											</div>
										</div>

										<div class="tab-pane" id="tab2">
											<div class="row form-group add-image">

												<div class="col-sm-12">
													@*   <h5><i class="fa fa-upload" aria-hidden="true"></i>Ödeme yöntemini seçiniz.</h5>*@
													<br /><br />
													<!-- tabs left -->
													<div class="tabbable tabs-left">

														<ul class="nav nav-tabs">
															<li class="active">
																<a href="#a" data-toggle="tab">
																	<span class="glyphicon glyphicon-credit-card"></span>&nbsp; Kredi Kartı
																</a>
															</li>
															@*<li><a href="#b" data-toggle="tab"><span class="glyphicon glyphicon-transfer"></span>&nbsp;Havale</a></li>*@
														</ul>

														<div class="tab-content">

															<div class="tab-pane active" id="a">
																<br /><br />

																<div id="loadgifdiv" style="width:100%; text-align:center;" class="center"></div>

																<div id="iyzipay-checkout-form" class="responsive"></div>

															</div>
															<div class="tab-pane" id="b">
																<br /><br />
																<small>
																	Bu andan itibaren 7 gün içinde, siparişinizi hazırlanmak üzere işleme alabilmek için siparişinize ait ödemenin Kitapyurdu'na ulaşması beklenecektir.
																	Bu sırada ödeme ulaşmaz ise 2 adet ödemeyi hatırlatan e-posta gönderilecek, yine ödeme ulaşmadığında ise 7 gün sonra siparişiniz otomatik olarak iptal edilecektir.
																	Dikkat! EFT veya havalelerde açıklama kısmına sipariş numarasını ve EFT lerde firma adına "eticaret sitesi" yazmayı unutmayınız.
																</small>
																<br /><br />

																@foreach (var item in ViewBag.Havale as List<HemenTanitim.Models.Havale>)
																{
																	<div style="background-color:white; padding:10px;">
																		@item.bankaAdi<br />
																		(Şubesi : @item.bankaSubesi Şube kodu : @item.subeKodu) Hes. No:@item.hesapNo<br />
																		IBAN: @item.iban
																	</div>
																	<br /><br />
																}

																<input type="button" id="btn_HavaleSiparisi" class="btn btn-info next" value="Devam et" />

															</div>

														</div>
													</div>
													<!-- /tabs -->
												</div>

											</div>

										</div>
									</div><!-- section -->
								</div>
							</div>
						</fieldset>

					</div>


					<!-- quick-rules -->
					<div class="col-md-4">
						@*<div class="section quick-rules">
							<h4>Ürün Bilgileri</h4>
							<p class="lead">Posting an ad on <a href="#">Trade.com</a> is free! However, all ads must follow our rules:</p>
							<ul>
								<li>Toplam : <label id="lblAraToplam"></label></li>

							</ul>
						</div>*@
						<div class="section quick-rules">
							<h4>Ödenecek Sepet Tutarı </h4>
							<h2>@ViewBag.UrunTutari ₺</h2>
						</div>
					</div><!-- quick-rules -->

				</div><!-- photos-ad -->
			</div>
		</div>
	</section>

		<script src="/Scripts/bootstrap.min.js"></script>

	<script>


	   function getFileData(myFile) {

			var file = myFile.files[0];
     
			document.getElementById("secilenDosya").innerHTML = "Seçilen Dosya : " + file.name;

		}
		var $CKEDITOR = jQuery.noConflict();

		$CKEDITOR(document).ready(function () {
			CKEDITOR.replace('TanitimIcerik', {
				customConfig: "/Scripts/plugins/ckeditor/simple_config.js"
			});
		});

	</script>

	<script src="~/Scripts/jquery-ui-1.8.20.min.js"></script>

	<script src="~/Scripts/jquery.validate.1.9.min.js"></script>

	<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>

	<script src="~/Content/tabs/jquery.bootstrap.wizard.js"></script>

	<script src="~/Content/tabs/prettify.js"></script>  

	<script src="~/Scripts/plugins/ckeditor/ckeditor.js"></script>

	<script src="~/js/SiparisGirisi.js"></script>
