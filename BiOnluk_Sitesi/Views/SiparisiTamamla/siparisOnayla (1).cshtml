
@model HemenTanitim.Models.SiparisBilgileri
@using HemenTanitim.Models;
@using Microsoft.AspNet.Identity;

@{
    ViewBag.Title = "siparisOnayla";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Askbootstrap">
    <meta name="author" content="Askbootstrap">
    <link rel="icon" type="image/png" href="img/logo.png">
    <title>TYP - Online Food Ordering </title>
    <!-- Slick Slider -->
    <link rel="stylesheet" type="text/css" href="~/Content/UI/vendor/slick/slick.min.css" />
    <link rel="stylesheet" type="text/css" href="~/Content/UI/vendor/slick/slick-theme.min.css" />
    <!-- Feather Icon-->
    <link href="~/Content/UI/vendor/icons/feather.css" rel="stylesheet" type="text/css">
    <!-- Bootstrap core CSS -->
    <link href="~/Content/UI/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <!-- Custom styles for this template -->
    <link href="~/Content/UI/css/style.css" rel="stylesheet">
    <!-- Sidebar CSS -->
    <link href="~/Content/UI/vendor/sidebar/demo.css" rel="stylesheet">

    <link href="~/Content/FrontEnd/css/siparisOnayla.css" rel="stylesheet" />
</head>
<body class="bg-light fixed-bottom-bar">
    <div class="osahan-payment">
        <div class="p-3 osahan-inner-header bg-white shadow-sm">
            <div class="d-flex align-items-center">
                <a class="font-weight-bold text-dark text-back text-decoration-none " href="/">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="back-page bi bi-chevron-left" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"></path>
                    </svg>
                </a>
                <span class="ml-3 h6 mb-0">Back</span>
                <div class="ml-auto d-flex align-items-center">
                    <a class="text-danger mx-2 top-nav-btn top-nav-btn-cart fs-18 position-relative" href="https://wa.me/905373666046?text=My Order Number is : @Model.SiparisId. I want to information about my order. "><i class="feather-phone-call"></i></a>
                    <a class="toggle ml-2 text-dark hc-nav-trigger hc-nav-1" href="#" role="button" aria-controls="hc-nav-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-list" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M2.5 11.5A.5.5 0 0 1 3 11h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4A.5.5 0 0 1 3 7h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4A.5.5 0 0 1 3 3h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"></path>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
        <!-- checkout -->
        <div class="py-3 osahan-cart-item">
            <div class="osahan-cart-item-profile bg-white shadow p-3">
                <div class="d-flex flex-column">
                    <h6 class="mb-4 font-weight-bold text-center">LIVE ORDER TRACKING </h6>
                    <div class="custom-control custom-radio mb-2 px-0 myDIV" id="birinciDiv">
                        <input type="radio" id="customRadio1" name="customRadio" class="custom-control-input" checked>
                        <label class="custom-control-label border osahan-check p-3 w-100 rounded border-primary" for="customRadio1">
                            <b><img id="img1_" src="/Content/FrontEnd/images/track_icons/food_.png" height="30" /> Order is prepearing...</b> <br>
                            <p class="small mb-0 pl-1">We received your order and started to prepare.</p>
                        </label>
                    </div>
                    <div class="custom-control custom-radio mb-2 px-0" id="ikinciDiv">
                        <input type="radio" id="customRadio2" name="customRadio" class="custom-control-input">
                        <label class="custom-control-label border osahan-check p-3 w-100 rounded bg-light" for="customRadio2">
                            <b> <img id="img2_" src="~/Content/FrontEnd/images/track_icons/food_.png" height="30" /> Order is shipped...</b> <br>
                            <p class="small mb-0 pl-1">Your order has been prepared, you will have it soon.</p>
                        </label>
                    </div>
                    <div class="custom-control custom-radio mb-2 px-0" id="UcuncuDiv">
                        <input type="radio" id="customRadio3" name="customRadio" class="custom-control-input">
                        <label class="custom-control-label border osahan-check p-3 w-100 rounded bg-light" for="customRadio3">
                            <b>  <img id="img3_" src="~/Content/FrontEnd/images/track_icons/food_.png" height="30" /> Order is delivered</b> <br>
                            <p class="small mb-0 pl-1">Your order has been delivered. Enjoy your meal :)</p>
                        </label>
                    </div>

                </div>
            </div>
        </div>
        <div class="accordion pb-3" id="accordionExample">
            <div class="osahan-card bg-white overflow-hidden shadow mb-2">
                <div class="osahan-card-header" id="headingOne">
                    <h2 class="mb-0">
                        <button class="d-flex p-3 align-items-center btn btn-link w-100" type="button" data-toggle="collapse" data-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                            <i class="feather-credit-card mr-3"></i> Order Summary
                            <i class="feather-chevron-down ml-auto"></i>
                        </button>
                    </h2>
                </div>
                <div id="collapseOne" class="collapse show" aria-labelledby="headingOne" data-parent="#accordionExample">
                    <div class="osahan-card-body border-top pl-3">
                        <h6 class="m-0"> @Html.Raw(Model.IlanAciklama)</h6>

                        <p class="small  pt-2"><span class="osahan-card font-weight-bold">( Order Number : @Model.SiparisId )</span></p>
                        <form>
                            <div class="form-row">
                                <div class="col-md-12 form-group">
                                    <label class="form-label mb-1 small">  <small>@Model.SiparisTarihi</small></label>
                                    <div class="input-group">
                                        <h6 class="mb-3 mt-0 mb-3 font-weight-bold">Total :  @Model.Tutar TL </h6>
                                    </div>
                                </div>

                            </div>
                        </form>
                    </div>
                </div>
            </div>

        </div>

    </div>

    @Html.Partial("_LoginPartial")
    <!-- Bootstrap core JavaScript -->

    @Scripts.Render("~/bundles/jquery")

    <script src="~/Content/UI/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- slick Slider JS-->
    <script type="text/javascript" src="~/Content/UI/vendor/slick/slick.min.js"></script>
    <!-- Sidebar JS-->
    <script type="text/javascript" src="~/Content/UI/vendor/sidebar/hc-offcanvas-nav.js"></script>
    <!-- Custom scripts for all pages-->
    <script src="~/Content/UI/js/osahan.js"></script>


    @Html.Hidden("Get", Url.Action("GetSiparisler", "SiparisiTamamla", new { SiparisId = Model.SiparisId }))
    <script src="~/Scripts/jquery.signalR-2.2.1.min.js"></script>
    <script src="~/signalr/hubs" type="text/javascript"></script>
    <script>

        var $ol = jQuery.noConflict();

        $ol(function () {

            // Proxy created on the fly
            var job = $ol.connection.siparisOnayla;

            // Declare a function on the job hub so the server can invoke it
            job.client.displaySiparisler = function () {
                getData();
            };

            //Start the connection
            $ol.connection.hub.start();
            getData();
        });

        function getData() {
            $ol.ajax({
                //HomeController/GetSiparişler içerisinden çekiyorum.
                url: $ol("#Get").val(),
                type: 'GET',
                datatype: 'json',
                success: function (data) {

                    switch (data) {
                        case 1:
                            //$ol("#img1_").addClass("myDIV");
                            break;
                        case 2:
                            $ol("#customRadio1").attr("checked", false);
                            $ol("#customRadio2").attr("checked", true);

                            $ol("#birinciDiv").removeClass("myDIV");                        
                            $ol("#UcuncuDiv").removeClass("myDIV");
                            $ol("#ikinciDiv").addClass("myDIV");
                            break;
                        case 3:                           
                            $ol("#customRadio2").attr("checked", false);
                            $ol("#customRadio3").attr("checked", true);

                            $ol("#birinciDiv").removeClass("myDIV");
                            $ol("#ikinciDiv").removeClass("myDIV");
                            $ol("#UcuncuDiv").addClass("myDIV");
                            break;
                    }
                }
            });
        }

        function getFileData(myFile) {

            var file = myFile.files[0];

            document.getElementById("secilenDosya").innerHTML = "Seçilen Dosya : " + file.name;

        }
                    //var $CKEDITOR = jQuery.noConflict();

                    //$CKEDITOR(document).ready(function () {
                    //    CKEDITOR.replace('TanitimIcerik', {
                    //        customConfig: "/Scripts/plugins/ckeditor/simple_config.js"
                    //    });
                    //});

    </script>
</body>
</html>