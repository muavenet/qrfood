@model HemenTanitim.Models.Blog
@using Resources;
@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/Admin.cshtml";
}



<aside class="right-side">
    <section class="content-header">
        <h1>
            Blog kayýt düzenleme
        </h1>
        <ol class="breadcrumb">
            <li><a href="@Url.Action("Dasboard")"><i class="fa fa-dashboard"></i> Anasayfa</a></li>
            <li><a href="@Url.Action("Index")">Ürün iþlemleri</a></li>
            <li class="active">Ürün Ekle</li>
        </ol>
    </section>
    <section class="content">
        <div class='row'>
            <div class='col-md-12'>
                <div class='box box-purple'>

                    <div class='box-header'>
                        <h3 class='box-title'>Düzenle</h3>
                    </div>


                    <div class="box-body">


                        @using (Html.BeginForm("Edit", "Blogs", FormMethod.Post, new { @class = "form-horizontal", @id = "block-validate", enctype = "multipart/form-data" }))
                        {

                            @Html.ValidationSummary(true)

                            @Html.AntiForgeryToken()

                            @Html.HiddenFor(model => model.Id)
                            
                            @Html.HiddenFor(model => model.Resim)


                            <div class="form-group">
                                <div class="col-md-10">

                                    <img src="@Url.Content("~/Content/uploads/" + Model.Resim)" width="200" height="105" />
                                </div>
                            </div>
                            @Html.Partial("_CreateOrEdit", Model)

                            <div class="form-actions no-margin-bottom" style="text-align:center;">
                                <input type="submit" value="Kaydet" class="btn btn-primary btn-lg " />
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div>
            @Html.ActionLink("<< Listeye geri don", "Index")
        </div>
        </section></aside>

@section scriptFooter{
  <script src="~/Scripts/plugins/ckeditor/ckeditor.js"></script>
    <script>

        $(document).ready(function () {

            var roxyFileman = '../../Scripts/plugins/ckeditor/plugins/fileman/index.html';

            CKEDITOR.replace('Icerik',
                {
                    filebrowserBrowseUrl: roxyFileman,
                    filebrowserImageBrowseUrl: roxyFileman + '?type=image',
                    removeDialogTabs: 'link:upload;image:upload',
                    height: '200px'
                });


            $("li").removeClass("active");
            $("#blog").addClass("active");
        });
    </script>



}

