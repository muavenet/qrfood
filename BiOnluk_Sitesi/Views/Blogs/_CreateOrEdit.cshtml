    </div>
</div>



<div class="form-group">

    <div class="col-lg-6">
        @Html.TextBoxFor(model => model.Baslik, new { @class = "form-control", @id = "required2", @name = "required2", @placeholder = "Baþlýðý giriniz" })
        @Html.ValidationMessageFor(model => model.Baslik)
