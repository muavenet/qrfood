@model HemenTanitim.Models.Blog
@using Resources;






<div class="form-group">
    <div class="col-md-10">
        <label for="foto">Fotoðraf:</label>
        <input type="file" name="foto" id="file1" />
    </div>
</div>

<div class="form-group">
    <div class="col-md-10">
        @Html.LabelFor(model => model.title)
        @Html.TextBoxFor(model => model.title, new { @class = "form-control" })
