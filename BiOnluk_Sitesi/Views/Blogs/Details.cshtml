@model HemenTanitim.Models.Blog

@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/Admin.cshtml";
}



<link rel="stylesheet" href="~/assets/plugins/validationengine/css/validationEngine.jquery.css" />

<div id="content">

    <div class="inner" style="min-height: 700px;">

        <div class="row">
            <div class="col-lg-12">

                <p>
                    <h2>Blog</h2>
                </p>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <div class="panel panel-default">
                    <div class="panel-heading">
                       Detaylar
                    </div>
                    <div class="panel-body">

                        <table class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th class="col-md-2">Baþlýklar</th>
                                    <th>Ýcerikler</th>
                                </tr>
                            </thead>
                            <tbody>



                                <tr>
                                    <td>
                                        <span>Baþlýk</span>
                                    </td>
                                    <td>
                                        @Model.Baslik
                                    </td>
                                </tr>




                                <tr>
                                    <td>
                                        <span>Ýçerik</span>
                                    </td>
                                    <td>
                                        @Model.Icerik
                                    </td>
                                </tr>




                                <tr>
                                    <td>
                                        <span>Yazan</span>
                                    </td>
                                    <td>
                                        @Model.Yazan
                                    </td>
                                </tr>




                                <tr></tr>



                                <tr>
                                    <td colspan="2">
                                        @using (Html.BeginForm())
                                        {
                                            <div class="form-group">

                                                <div class="col-lg-4">                                                  
                                                    @Html.ActionLink("Listeye geri don", "Index")

                                                </div>
                                            </div>



                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {

        $("#wysihtml5").wysihtml5();
        $("li").removeClass("active");
        $("#blog").addClass("active");

        $("#wysihtml5").wysihtml5();
    });
</script>