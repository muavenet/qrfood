@model HemenTanitim.Models.Blog

@{
    ViewBag.Title = "Delete";

    Layout = "~/Views/Shared/Admin.cshtml";
}


<aside class="right-side">
    <section class="content-header">
        <h1>
            Blog kayýt düzenleme
        </h1>
        <ol class="breadcrumb">
            <li><a href="@Url.Action("Dasboard")"><i class="fa fa-dashboard"></i> Anasayfa</a></li>
            <li><a href="@Url.Action("Index")">Ürün iþlemleri</a></li>
            <li class="active">Ürün Ekle</li>
        </ol>
    </section>
    <section class="content">
        <div class='row'>
            <div class='col-md-12'>
                <div class='box box-purple'>

                    <div class='box-header'>
                        <h3 class='box-title'> Silmek istediginize emin misiniz?</h3>
                    </div>


                    <div class="box-body">


                        <div class="box-body table-responsive" style="overflow:hidden">
                            <table id="tblListe" class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th class="col-md-2">Baþlýklar</th>
                                        <th>Ýçerikler</th>
                                    </tr>
                                </thead>
                                <tbody>



                                    <tr>
                                        <td>
                                            <span>Baslik</span>
                                        </td>
                                        <td>
                                            @Model.Baslik
                                        </td>
                                    </tr>




                                    <tr>
                                        <td>
                                            <span>Icerik</span>
                                        </td>
                                        <td>
                                            @Model.Icerik

                                        </td>
                                    </tr>




                                    <tr>
                                        <td>
                                            <span>Yazan</span>
                                        </td>
                                        <td>
                                            @Model.Yazan
                                        </td>
                                    </tr>




                                    <tr></tr>



                                    <tr>
                                        <td colspan="2">
                                            @using (Html.BeginForm())
                                            {
                                                <div class="form-group">

                                                    <div class="col-lg-4">
                                                        <input type="submit" value="Sil" class="btn btn-primary btn-sm " /> |
                                                        @Html.ActionLink("Listeye geri don", "Index")

                                                    </div>
                                                </div>



                                            }
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                        </div>
                    </div>
            </div>
        </div>
        </div>
        </section></aside>

<script>

    $(document).ready(function () {

        $("#wysihtml5").wysihtml5();
        $("li").removeClass("active");
        $("#blog").addClass("active");

        $("#wysihtml5").wysihtml5();
    });
</script>

