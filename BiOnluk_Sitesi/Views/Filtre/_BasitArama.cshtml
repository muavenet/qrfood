



<script src="https://code.jquery.com/jquery-3.6.0.js"></script>
<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.js"></script>
<style>
    #VisitorDetail {
        border-color: white;
        padding: 15px;
        border: 1px solid #e3e3e3;
        margin-top: 1px;
        border-radius: 8px;
        position: absolute;
        background-color: white;
     
        width: 94%;
    }
        #VisitorDetail div {
            margin-top: 5px;
            margin-bottom: 10px;
        }
        #VisitorDetail a {
            font-size: 14px;
        
        }
</style>



<div class="input-group border osahan-search mt-3 rounded-lg shadow-sm overflow-hidden">

    <div class="input-group-prepend">
        <button class="border-0 btn btn-outline-secondary text-primary bg-white btn-block"><i class="feather-search"></i></button>
    </div>

    <input type="text" name="PassId" id="PassId" class="shadow-none border-0 form-control pl-0" placeholder="Search for foods" />

</div>



<div id="VisitorDetail">
    <div id="baslik"></div>

</div>

<script type="text/javascript">


    $("#PassId").on('input', function () {
            if ($(this).val().length == 0) return;
        $('#VisitorDetail').hide();
        });

        $(document).ready(function () {
            $('#VisitorDetail').hide();
        });
        $("#PassId").autocomplete({
            minLength: 3,
        source: function (request, response) {
            var customer = new Array();
            $.ajax({
                async: false,
                cache: false,
                type: "POST",

                url: "@(Url.Action("Template_GetCustomers", "Filtre"))",
                data: { "text": request.term },
                success: function (data) {
                    $("#VisitorDetail").empty();
                    $('#VisitorDetail').show();
                    for (var i = 0; i < data.length; i++) {
                        $("#VisitorDetail").append("<div><a href='/Filtre/BasitAramaSonuc/" + data[i].ArananKelime + "/10/" + data[i].AltKategoriId + " '>" + data[i].baslik + " in <strong>" + data[i].AltKategoriAdi.substring(0, 15) +" </strong></a></div>");

                    }
                }
            });
          
            },
            select: function () {
                // prevent value inserted on focus
                $('#VisitorDetail').hide();
            }
     });

</script>