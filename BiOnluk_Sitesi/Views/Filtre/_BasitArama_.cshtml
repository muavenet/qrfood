<!-- Bootstrap 4 Autocomplete -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap-4-autocomplete/dist/bootstrap-4-autocomplete.min.js" crossorigin="anonymous"></script>

<script type="text/javascript">
    var j5 = $.noConflict(true);


    var src = {
        "bootstrap 4 Autocomplete example": 1,
        "Best example in the world": 2,
        "Bootstrap 4 Autocomplete is very nice": 3,
        "It contains neatly arranged example items": 4,
        "With many autocomplete values": 5,
        "And it uses default Bootstrap 4 components": 6,
        "You can use this example to test": 7,
    }

    function onSelectItem(item, element) {
        j5('#output').html(
            'Element <b>' + j5(element).attr('id') + '</b> was selected<br/>' +
            '<b>Value:</b> ' + item.value + ' - <b>Label:</b> ' + item.label
        );
    }

    j5('#myAutocomplete').autocomplete({
        source: src,
        onSelectItem: onSelectItem,
        highlightClass: 'text-danger',
        treshold: 2,
    });


    //var $g = jQuery.noConflict();

    function onAdditionalData() {
        return {
            text: j5("#customers").val()

        };
    }

    function onChange(e) {

        console.log("xx");
        e.preventDefault();

        window.location.replace(e.item[0].childNodes[0].firstElementChild.attributes[1].nodeValue);
    }

    function onFiltering(e) {

        if (e.filter.value == "") {
            e.preventDefault();
            e.sender.dataSource.data([]);
        }
    }

    //$g("#altKategoriAdi_span").add("#auto_class").bind("keypress click", function (e) {
    //	alert("huhu");
    //	e.preventDefault();
    //});

</script>




