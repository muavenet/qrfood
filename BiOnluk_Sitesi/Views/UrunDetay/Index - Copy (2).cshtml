                        </li>

                        @*<li><i class="fa fa-bar-chart-o"></i><a id="@Model.isId" data-toggle="tooltip" data-placement="right" title="Karşılaştır" onclick="KarsilastirmaEkle(this); return false" href="#">Karşılaştırma tabloma ekle</a></li>*@

