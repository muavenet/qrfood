<div class="px-3 pt-3">
    <div class="recepie-body">
        <div class="p-3">
            <h6 class="font-weight-bold">Description</h6>
            <p class="text-muted">@Model.aciklama</p>
            @*<h6 class="font-weight-bold mt-4">Extras</h6>
            <div class="rounded border radio-btn-list filter">
                <div class="custom-control border-bottom px-0 custom-checkbox">
                    <input type="checkbox" class="custom-control-input" id="defaultCheck1" checked>
                    <label class="custom-control-label py-3 w-100 px-3" for="defaultCheck1">Tuna</label>
                </div>
                <div class="custom-control border-bottom px-0 custom-checkbox">
                    <input type="checkbox" class="custom-control-input" id="defaultCheck2">
                    <label class="custom-control-label py-3 w-100 px-3" for="defaultCheck2">class</label>
                </div>
                <div class="custom-control px-0 custom-checkbox">
                    <input type="checkbox" class="custom-control-input" id="defaultCheck3">
                    <label class="custom-control-label py-3 w-100 px-3" for="defaultCheck3">Wasabi</label>
                </div>
            </div>*@
            <h6 class="font-weight-bold mt-4">Quantity</h6>
            <div class="d-flex align-items-center">
                <p class="m-0">1 Item</p>
                <div class="ml-auto">
                    <select class="custom-select custom-select-sm my-1 mr-sm-2" id="inlineFormCustomSelectPref">
                    
                        <option value="1">One</option>
                        <option value="2">Two</option>
                        <option value="3">Three</option>
                        <option value="4">Four</option>
                        <option value="5">Five</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="fixed-bottom p-3">
    <a id="SepeteAt" class="btn btn-success btn-block btn-lg text-white rounded shadow text-decoration-none d-flex align-items-center shadow">
        <div class="border-right pr-3">
            <h4 class="m-0"><i class="feather-shopping-bag" aria-hidden="true" id="thickOlacak"></i></h4>
        </div>
        <div class="ml-3 text-left">
            <p class="mb-0 font-weight-bold text-white">
                <span id="spFiyat" class="notranslate"> @String.Format("{0:N}", Model.MinFiyat) TL</span> 
            </p>
        </div>
        <div class="ml-auto">
            <p class="mb-0 text-white" id="">
                Add to cart <i class="feather-chevron-right pl-2" aria-hidden="true"></i>
            </p>
        </div>
    </a>
</div>


