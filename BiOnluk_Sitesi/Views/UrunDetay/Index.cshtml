

@model  HemenTanitim.Models.IsIlanlariListele_IlanDetay



@{
    ViewBag.Title = "";
    Layout = null;

}

<!DOCTYPE html>
<html lang="en">
<head>
   
    <link rel="icon" type="image/png" href="img/logo.png">
    <title>TYP - Online Food Ordering</title>
    <!-- Slick Slider -->
    <link rel="stylesheet" type="text/css" href="~/Content/UI/vendor/slick/slick.min.css" />
    <link rel="stylesheet" type="text/css" href="~/Content/UI/vendor/slick/slick-theme.min.css" />
    <!-- Feather Icon-->
    <link href="~/Content/UI/vendor/icons/feather.css" rel="stylesheet" type="text/css">
    <!-- Bootstrap core CSS -->
    <link href="~/Content/UI/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <!-- Custom styles for this template -->
    <link href="~/Content/UI/css/style.css" rel="stylesheet">
    <!-- Sidebar CSS -->
    <link href="~/Content/UI/vendor/sidebar/demo.css" rel="stylesheet">
</head>
<body class="fixed-bottom-bar">
    <div class="osahan-restaurant">
        <div class="osahan-restaurant-detail">
            <div class="p-3 osahan-inner-header bg-primary">
                <div class="d-flex align-items-center">
                    <a class="font-weight-bold text-white text-back text-decoration-none d-flex" href="/">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor"
                             class="back-page bi bi-chevron-left" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"></path>
                        </svg>
                        <span class="pl-2">Back</span>
                    </a>
                    <div class="ml-auto d-flex align-items-center">
                        @{Html.RenderAction("_Sepet");}
                        <a class="text-white mx-2 top-nav-btn top-nav-btn-cart fs-18 position-relative" id="@Model.isId"  onclick="FavorilerimeEkle(this); return false" href="#"><i class="feather-star"></i></a>
                        <a class="text-white mx-2 top-nav-btn top-nav-btn-cart fs-18 position-relative" href="#ratings-and-reviews"><i class="feather-map-pin"></i></a>
                        <a class="text-white mx-2 top-nav-btn top-nav-btn-cart fs-18 position-relative" href="contact-us.html"><i class="feather-phone"></i></a>
                        <a class="toggle ml-2 text-white hc-nav-trigger hc-nav-1" href="#" role="button" aria-controls="hc-nav-1">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-list" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M2.5 11.5A.5.5 0 0 1 3 11h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4A.5.5 0 0 1 3 7h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4A.5.5 0 0 1 3 3h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
            <div class="px-3 pt-4 pb-3 bg-primary">
                <div>
                    <h2 class="font-weight-bold text-white">@Model.baslik</h2>
                    <p class="font-weight-light text-white-50 m-0">TYP, Food Delivery</p>
                    <div class="rating-wrap d-flex align-items-center mt-2">

                        @if (Model.Trending == true)
                        {
                            <ul class="rating-stars list-unstyled m-0">

                                <li>
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        <i class="feather-star text-warning"></i>
                                    }

                                </li>
                            </ul>
                            <p class="label-rating text-white-50 ml-2 m-0"><span class="badge badge-info">Trending</span></p>
                        }
                        else if (Model.Hot == true)
                        {
                            <ul class="rating-stars list-unstyled m-0">

                                <li>
                                    @for (int i = 0; i < 4; i++)
                                    {
                                        <i class="feather-star text-warning"></i>
                                    }
                                    <i class="feather-star"></i>
                                </li>
                            </ul>
                            <p class="label-rating text-white-50 ml-2 m-0"><span class="badge badge-dark">Hot</span></p>
                        }
                        else if (Model.Promoted == true)
                        {
                            <ul class="rating-stars list-unstyled m-0">

                                <li>
                                    @for (int i = 0; i < 4; i++)
                                    {
                                        <i class="feather-star text-warning"></i>
                                    }
                                    <i class="feather-star"></i>
                                </li>
                            </ul>
                            <p class="label-rating text-white-50 ml-2 m-0"><span class="badge badge-success">Promoted</span></p>
                        }


                    </div>
                </div>
                <div class="pt-4">
                    <div class="row">
                        <div class="col-6">
                            <p class="m-0 small text-white">Delivery <span class="badge badge-osahan badge-warning small">Free</span></p>
                        </div>
                        <div class="col-6 text-right">
                            <p class="m-0 small text-white">Open time <span class="badge badge-osahan badge-dark small">24 Hours</span></p>
                        </div>
                    </div>
                </div>
            </div>
            <div>
                <p class="font-weight-bold px-3 pt-3 m-0">
                    <a href="/" title="Anasayfa">Home</a> /
                    <a href="@Model.AnaKategoriLink" title="@Model.baslik.ToSeoUrl()">@Model.AnaKategoriAdi</a> /
                    <a href="@Url.RouteUrl("AltKategorilerSayfasi", new {AltKategoriId = Model.AltKategoriId, AltKategoriAdi = Model.AltKategoriAdi.turkceSeoUrl(), })"
                       title="@Model.baslik.ToSeoUrl()">@Model.AltKategoriAdi</a>
                </p>
                <!-- slider -->
                @{Html.RenderAction("_SliderPartial");}


            </div>
        </div>
        <!-- Menu -->
        <!-- Footer -->

        @{Html.RenderAction("_IlanOdemeyeGit");}

    </div>

    @Html.Partial("_LoginPartial")






    <!-- Bootstrap core JavaScript -->
    <script src="~/Content/UI/vendor/jquery/jquery.min.js"></script>
    <script src="~/Content/UI/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- slick Slider JS-->
    <script type="text/javascript" src="~/Content/UI/vendor/slick/slick.min.js"></script>
    <!-- Sidebar JS-->
    <script type="text/javascript" src="~/Content/UI/vendor/sidebar/hc-offcanvas-nav.js"></script>
    <!-- Custom scripts for all pages-->
    <script src="~/Content/UI/js/osahan.js"></script>



    @if (Request.IsAuthenticated)
    {
        <script src="~/js/FavorilerimeEkle.js"></script>
        @*<script src="~/js/KarsilastimaEkle.js"></script>*@
    }

    <script src="~/js/UrunDetay.js"></script>





    <script type="text/javascript">

		@*var $yorum = jQuery.noConflict();

		$yorum("#btnYorumGonder").click(function (e) {

			if ($yorum(".cnt-form")[0].checkValidity()) {

                e.preventDefault();

				MYLIBRARY.init([$yorum("#exampleInputName").val(), $yorum("#exampleInputReview").val(), @Model.isId]);
                MYLIBRARY.yorumfonksiyonu();
            };

        });*@

        var $fArama = jQuery.noConflict();

        $fArama('.currency').on('keyup', function () {
            jQuery(this).val(jQuery(this).val().split('.').join(''));
            jQuery(this).val((jQuery(this).val()).replace(/\B(?=(?:\d{3})+(?!\d))/g, "."));

		});

        function HAltKatlariGetir(e) {

            var element = $fArama("#HAltKat li");
            var temizle1 = $fArama("#hizliAramaSiteAltKategori");


            $fArama.ajax({
                url: '/KategoriListesiGetir/HizliAramaaltKategorileriGetir',
                type: "GET",
                dataType: "JSON",
                data: { anaKatId: e },
                success: function (cities) {

                    element.remove();

                    temizle1.empty();

                    temizle1.append("Site Kategorisi Seçiniz");

                    $fArama.each(cities, function (i, city) {

                        $fArama("#HAltKat").append(

                        $fArama('<li><a href="#"><span id="firstKatAd">' + city.KategoriAdi + '</span> <span id="secondKatI" style="visibility:hidden">' + city.Id + '</span></a></li>'));
                    });
                }
            });
        }


        $fArama("#btnHizliMenuArama").click(function () {



            var maxAlexa = $fArama("#hizliAramaMaxAlexa").val().replace(/\./g, "");
            var SiteKoriAdi = $fArama("#hizliAramaSiteKategori span#firstKatAd").text();
            var SiteKategori = $fArama("#hizliAramaSiteKategori span#secondKatI").text();
            var SiteKategoriAltKatAdi = $fArama("#hizliAramaSiteAltKategori span#firstKatAd").text();
            var SiteAltKategori = $fArama("#hizliAramaSiteAltKategori span#secondKatI").text();

            if ($fArama("#hizliAramaSiteKategori").text() == "Kategori Seçiniz") {
                alert("Kategori Seçiniz");
                return false;
            }


            if ($fArama("#hizliAramaSiteAltKategori").text() == "Site Kategorisi Seçiniz") {
                alert("Site Kategorisi Seçiniz");
                return false;
            }



            if (maxAlexa == "") {

                maxAlexa = 0;
            }



            var aKaAdi = "@Model.AnaKategoriAdi.Trim()";
            var altKaAdi = "@Model.AltKategoriAdi.Trim()";
            var aKaId = "@Model.AnaKategoriId";
            var altKaId = "@Model.AltKategoriId";



            var url = "/UrunListesi/FiltreliUrunler/" + aKaAdi + "/" + aKaId + "/" + altKaAdi + "/" + altKaId + "/0/0/0/" + maxAlexa + "/false/false/en_yeniler/1" + "";

            window.location.replace(url);

            return false;
		});

    </script>
    
<script type="text/javascript">
    function googleTranslateElementInit() {
        new google.translate.TranslateElement({ pageLanguage: 'en', includedLanguages: 'tr,es,fr,de,ko,pl,ru,zh-CN,ar', layout: google.translate.TranslateElement.InlineLayout.SIMPLE }, 'google_translate_element');
    }
</script>
<script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>


</body>
</html>