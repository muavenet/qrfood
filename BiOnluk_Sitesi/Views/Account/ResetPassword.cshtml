@model HemenTanitim.Models.ManageUserViewModel
@{
    ViewBag.Title = "Şifre yenile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="body-content outer-top-bd">
    <div class="container">
        <div class="sign-in-page inner-bottom-sm">
            <div class="row">


                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <h4 class="">@ViewBag.Title</h4>
                    <hr />
                    <div class="col-md-5">

                        <form action="" autocomplete="off" method="POST">
                            <div class="form-group">


                                @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", placeholder = "Yeni şifre" })

                            </div>
                            <br />
                            <div class="form-group">


                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Yeni şifre tekrar" })

                            </div>
                            <button class="btn btn-lg btn-primary" type="submit">Kaydet</button>
                        </form>

                      
                    </div>

                }
            </div>
        </div>
    </div>
  
</div>
