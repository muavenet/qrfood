@model HemenTanitim.Models.LoginViewModel

@using Recaptcha.Web.Mvc;

@{
    ViewBag.Title = "ÜYE GİRİŞİ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .recaptchatable #recaptcha_response_field {
        bottom: 0px !important;
        margin: 3px 0 0 0 !important;
    }

    .form-control::placeholder {
        color: #aaaaaa !important;
    }

    .user-account input {
        margin-bottom: 2px !important;
    }
</style>

<section id="main" class="clearfix user-page">
    <div class="container">
        <div class="row text-center">
            <!-- user-login -->
            <div class="col-sm-8 col-sm-offset-2 col-md-6 col-md-offset-3">
                <div class="user-account">
                    <h2>Enter the your phone number</h2>

                    @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { role = "form" }))
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(true)

                        <label class="col-sm-12 label-title text-center" style="color:Red" id="lblBildirim">@Html.Raw(TempData["Hata"])</label>

                        <div class="form-group">
                            @Html.TextBoxFor(m => m.UserName, 
                           new { @class = "form-control",
                               type = "number", id 
                               = "telefon_", @placeholder = "+905373666660" })
                            <a href="#" onclick="register()"
                               class="form-control"
                               value="Search">Send confirm code to this number</a>
                            @Html.ValidationMessageFor(m => m.UserName)
                        </div>


                        <div class="form-group ">
                            @Html.TextBoxFor(m => m.Password, new { @class = "form-control", id = "exampleInputEmail3", @placeholder = "Enter the code sent to your phone" })
                            @Html.ValidationMessageFor(m => m.Password)
                        </div>

                        @*<div>
                            Kendi Site keyinizle değiştirin.
                            <div class="g-recaptcha" data-sitekey="6LeGoIQUAAAAALE1nJxo9Y9Sk3zCNexbK_cwaYQd"></div>
                            <br />
                            @Html.Recaptcha(theme: Recaptcha.Web.RecaptchaTheme.Default)
                        </div>*@

                        <div class="form-group">
                            @TempData["Message"]
                            <button type="submit" class="btn">Continue</button>
                        </div>

                    }

                    <!-- forgot-password -->
                    <!--<div class="user-option">
                        <div class="pull-left forgot-password">
                            <a href="@Url.Action("Register","Account")">Henüz üye değil misiniz ?</a>
                        </div>
                        <div class="pull-right forgot-password">
                            <a href="@Url.Action("ForgotPassword","Account")">Şifrenizi mi unuttunuz?</a>
                        </div>
                    </div>-->
                    <!-- forgot-password -->
                </div>

            </div><!-- user-login -->
        </div><!-- row -->
    </div><!-- container -->
</section><!-- signin-page -->




@section scripts{
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        function register() {

            var $con = jQuery.noConflict();
            var val = $con("#telefon_").val();    

            $con.ajax({
                url: "/Account/Register",
                data: { telefon: val },
                type: "POST",
                dataType: "json",
                success: function (result) {
                    if (result == true) {
                        $con("#lblBildirim").text("* The code has been sent");
                    }
                    else {
                        $con("#lblBildirim").text("* PLEASE, Enter your number");                                        }
                },
                error: function (error) { alert(error); }
            });

        }
    </script>

}